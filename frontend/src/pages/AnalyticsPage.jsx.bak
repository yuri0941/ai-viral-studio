import { useState } from 'react'
import {
    LineChart, Line, AreaChart, Area, BarChart, Bar, PieChart, Pie, Cell,
    XAxis, YAxis, CartesianGrid, Tooltip, ResponsiveContainer, Legend
} from 'recharts'

function AnalyticsPage() {
    const [period, setPeriod] = useState('7d')

    // Данные по периодам
    const dataByPeriod = {
        '7d': [
            { name: 'Пн', views: 12000, likes: 3400, comments: 890, shares: 450 },
            { name: 'Вт', views: 15000, likes: 4200, comments: 1100, shares: 580 },
            { name: 'Ср', views: 18000, likes: 5100, comments: 1350, shares: 720 },
            { name: 'Чт', views: 14000, likes: 3900, comments: 980, shares: 510 },
            { name: 'Пт', views: 22000, likes: 6300, comments: 1700, shares: 890 },
            { name: 'Сб', views: 28000, likes: 8100, comments: 2200, shares: 1150 },
            { name: 'Вс', views: 35000, likes: 10200, comments: 2800, shares: 1450 },
        ],
        '30d': [
            { name: 'Нед 1', views: 89000, likes: 25400, comments: 6800, shares: 3400 },
            { name: 'Нед 2', views: 112000, likes: 32100, comments: 8500, shares: 4200 },
            { name: 'Нед 3', views: 98000, likes: 27800, comments: 7200, shares: 3800 },
            { name: 'Нед 4', views: 134000, likes: 38700, comments: 10200, shares: 5100 },
        ],
        '90d': [
            { name: 'Мес 1', views: 340000, likes: 98000, comments: 26000, shares: 13000 },
            { name: 'Мес 2', views: 420000, likes: 121000, comments: 32000, shares: 16500 },
            { name: 'Мес 3', views: 510000, likes: 148000, comments: 39000, shares: 19800 },
        ]
    }

    const currentData = dataByPeriod[period]

    // Данные для Pie chart (платформы)
    const platformData = [
        { name: 'TikTok', value: 45, color: '#00ff41' },
        { name: 'Instagram', value: 25, color: '#2563eb' },
        { name: 'YouTube', value: 20, color: '#f0883e' },
        { name: 'Twitter', value: 10, color: '#8b5cf6' },
    ]

    // Топ видео
    const topVideos = [
        { title: 'Топ 5 лайфхаков для TikTok', platform: 'TikTok', views: '1.2M', likes: '45K', ctr: '12.5%' },
        { title: 'Как я заработал $10K за месяц', platform: 'YouTube', views: '890K', likes: '32K', ctr: '10.2%' },
        { title: 'Мотивация понедельника', platform: 'Instagram', views: '650K', likes: '28K', ctr: '9.8%' },
        { title: 'POV: Ты в 2026 году', platform: 'TikTok', views: '520K', likes: '22K', ctr: '8.7%' },
        { title: '3 ошибки начинающих блогеров', platform: 'YouTube', views: '410K', likes: '18K', ctr: '7.9%' },
    ]

    // Метрики
    const metrics = [
        { label: 'Всего просмотров', value: '1.4M', change: '+23%', positive: true },
        { label: 'Средний CTR', value: '8.4%', change: '+1.2%', positive: true },
        { label: 'Время просмотра', value: '4:32', change: '+18%', positive: true },
        { label: 'Подписчики', value: '12.5K', change: '+324', positive: true },
    ]

    const formatNumber = (num) => {
        if (num >= 1000000) return (num / 1000000).toFixed(1) + 'M'
        if (num >= 1000) return (num / 1000).toFixed(1) + 'K'
        return num.toString()
    }

    return (
        <div className="min-h-screen bg-[#0a0a0f] text-white">

            <main className="lg:ml-64 min-h-screen">
                <div className="p-6 lg:p-8 max-w-7xl mx-auto">
                    {/* Header */}
                    <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
                        <div>
                            <h1 className="text-3xl font-bold mb-2">Аналитика</h1>
                            <p className="text-gray-400">Отслеживай рост и эффективность контента</p>
                        </div>
                        <select
                            value={period}
                            onChange={(e) => setPeriod(e.target.value)}
                            className="bg-white/5 border border-white/10 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-[#00ff41]/30 w-fit"
                        >
                            <option value="7d">Последние 7 дней</option>
                            <option value="30d">Последние 30 дней</option>
                            <option value="90d">Последние 90 дней</option>
                        </select>
                    </div>

                    {/* Metrics */}
                    <div className="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
                        {metrics.map((metric, i) => (
                            <div key={i} className="glass rounded-2xl p-5 border-white/5">
                                <p className="text-sm text-gray-400 mb-2">{metric.label}</p>
                                <div className="flex items-end gap-3">
                                    <span className="text-2xl font-black">{metric.value}</span>
                                    <span className={`text-sm font-medium mb-1 ${metric.positive ? 'text-[#00ff41]' : 'text-red-400'}`}>
                                        {metric.change}
                                    </span>
                                </div>
                            </div>
                        ))}
                    </div>

                    {/* Main Chart */}
                    <div className="glass rounded-2xl p-6 border-white/5 mb-8">
                        <h3 className="font-bold mb-6">Вовлечённость аудитории</h3>
                        <ResponsiveContainer width="100%" height={350}>
                            <AreaChart data={currentData}>
                                <defs>
                                    <linearGradient id="viewsGrad" x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="5%" stopColor="#00ff41" stopOpacity={0.3} />
                                        <stop offset="95%" stopColor="#00ff41" stopOpacity={0} />
                                    </linearGradient>
                                    <linearGradient id="likesGrad" x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="5%" stopColor="#2563eb" stopOpacity={0.3} />
                                        <stop offset="95%" stopColor="#2563eb" stopOpacity={0} />
                                    </linearGradient>
                                </defs>
                                <CartesianGrid strokeDasharray="3 3" stroke="rgba(255,255,255,0.05)" />
                                <XAxis dataKey="name" stroke="rgba(255,255,255,0.3)" fontSize={12} />
                                <YAxis stroke="rgba(255,255,255,0.3)" fontSize={12} tickFormatter={formatNumber} />
                                <Tooltip
                                    contentStyle={{ background: '#0f0f1a', border: '1px solid rgba(255,255,255,0.1)', borderRadius: '12px' }}
                                    formatter={(value) => formatNumber(value)}
                                />
                                <Legend />
                                <Area type="monotone" dataKey="views" stroke="#00ff41" fill="url(#viewsGrad)" strokeWidth={2} name="Просмотры" />
                                <Area type="monotone" dataKey="likes" stroke="#2563eb" fill="url(#likesGrad)" strokeWidth={2} name="Лайки" />
                            </AreaChart>
                        </ResponsiveContainer>
                    </div>

                    {/* Second Row */}
                    <div className="grid lg:grid-cols-2 gap-6 mb-8">
                        {/* Platform Distribution */}
                        <div className="glass rounded-2xl p-6 border-white/5">
                            <h3 className="font-bold mb-6">Распределение по платформам</h3>
                            <ResponsiveContainer width="100%" height={300}>
                                <PieChart>
                                    <Pie
                                        data={platformData}
                                        cx="50%"
                                        cy="50%"
                                        innerRadius={60}
                                        outerRadius={100}
                                        paddingAngle={5}
                                        dataKey="value"
                                    >
                                        {platformData.map((entry, index) => (
                                            <Cell key={`cell-${index}`} fill={entry.color} />
                                        ))}
                                    </Pie>
                                    <Tooltip
                                        contentStyle={{ background: '#0f0f1a', border: '1px solid rgba(255,255,255,0.1)', borderRadius: '12px' }}
                                        formatter={(value) => `${value}%`}
                                    />
                                    <Legend />
                                </PieChart>
                            </ResponsiveContainer>
                        </div>

                        {/* Engagement Stats */}
                        <div className="glass rounded-2xl p-6 border-white/5">
                            <h3 className="font-bold mb-6">Статистика взаимодействий</h3>
                            <ResponsiveContainer width="100%" height={300}>
                                <BarChart data={currentData}>
                                    <CartesianGrid strokeDasharray="3 3" stroke="rgba(255,255,255,0.05)" />
                                    <XAxis dataKey="name" stroke="rgba(255,255,255,0.3)" fontSize={12} />
                                    <YAxis stroke="rgba(255,255,255,0.3)" fontSize={12} tickFormatter={formatNumber} />
                                    <Tooltip
                                        contentStyle={{ background: '#0f0f1a', border: '1px solid rgba(255,255,255,0.1)', borderRadius: '12px' }}
                                        formatter={(value) => formatNumber(value)}
                                    />
                                    <Legend />
                                    <Bar dataKey="comments" fill="#f0883e" radius={[4, 4, 0, 0]} name="Комментарии" />
                                    <Bar dataKey="shares" fill="#8b5cf6" radius={[4, 4, 0, 0]} name="Репосты" />
                                </BarChart>
                            </ResponsiveContainer>
                        </div>
                    </div>

                    {/* Top Videos */}
                    <div className="glass rounded-2xl p-6 border-white/5">
                        <h3 className="font-bold mb-6">Топ видео</h3>
                        <div className="overflow-x-auto">
                            <table className="w-full">
                                <thead>
                                    <tr className="border-b border-white/5">
                                        <th className="text-left py-3 px-4 text-sm font-medium text-gray-400">Видео</th>
                                        <th className="text-left py-3 px-4 text-sm font-medium text-gray-400">Платформа</th>
                                        <th className="text-right py-3 px-4 text-sm font-medium text-gray-400">Просмотры</th>
                                        <th className="text-right py-3 px-4 text-sm font-medium text-gray-400">Лайки</th>
                                        <th className="text-right py-3 px-4 text-sm font-medium text-gray-400">CTR</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {topVideos.map((video, i) => (
                                        <tr key={i} className="border-b border-white/5 hover:bg-white/[0.02] transition-colors">
                                            <td className="py-4 px-4">
                                                <div className="flex items-center gap-3">
                                                    <span className="text-lg font-bold text-gray-500 w-6">#{i + 1}</span>
                                                    <span className="font-medium">{video.title}</span>
                                                </div>
                                            </td>
                                            <td className="py-4 px-4">
                                                <span className={`text-xs px-2.5 py-1 rounded-full ${video.platform === 'TikTok' ? 'bg-[#00ff41]/10 text-[#00ff41]' :
                                                    video.platform === 'YouTube' ? 'bg-red-500/10 text-red-400' :
                                                        'bg-[#2563eb]/10 text-[#2563eb]'
                                                    }`}>
                                                    {video.platform}
                                                </span>
                                            </td>
                                            <td className="py-4 px-4 text-right font-medium">{video.views}</td>
                                            <td className="py-4 px-4 text-right text-gray-400">{video.likes}</td>
                                            <td className="py-4 px-4 text-right">
                                                <span className="text-[#00ff41] font-medium">{video.ctr}</span>
                                            </td>
                                        </tr>
                                    ))}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    )
}

export default AnalyticsPage
