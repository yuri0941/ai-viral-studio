    const tabs = [
        { id: 'overview', label: 'Обзор', icon: '\ud83d\udcca' },
        { id: 'team', label: 'Команда', icon: '\ud83d\udc65' },
        { id: 'cabinets', label: 'Кабинеты сотрудников', icon: '\ud83c\udfe2' },
        { id: 'finance', label: 'Финансы', icon: '\ud83d\udcb0' },
        { id: 'legal', label: 'Юр. лицо', icon: '\ud83d\udccb' },
        { id: 'audit', label: 'Аудит', icon: '\ud83d\udd0d' },
