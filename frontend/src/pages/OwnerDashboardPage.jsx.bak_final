    const allPermissions = [
        { id: 'chat', name: 'Чат поддержки', icon: MessageSquare },
        { id: 'tickets', name: 'Тикеты', icon: FileText },
        { id: 'content', name: 'Контент', icon: Briefcase },
        { id: 'scheduler', name: 'Планировщик', icon: Calendar },
        { id: 'campaigns', name: 'Кампании', icon: Megaphone },
        { id: 'analytics_view', name: 'Просмотр аналитики', icon: BarChart3 },
        { id: 'analytics_full', name: 'Полная аналитика', icon: TrendingUp },
        { id: 'users', name: 'Управление пользователями', icon: Users },
        { id: 'settings', name: 'Настройки', icon: Settings },
    ]

    const showToast = (message, type = 'success') => {
        setToast({ message, type })
        setTimeout(() => setToast(null), 3000)
    }

    const handleAddStaff = () => {
        if (!newStaffForm.name || !newStaffForm.email || !newStaffForm.password) {
            showToast('Заполните все поля', 'error'); return
        }
        const newMember = { id: Date.now(), name: newStaffForm.name, email: newStaffForm.email, role: newStaffForm.role, status: 'active', lastActive: 'Только что', tasks: 0 }
        setStaff([...staff, newMember])
        setNewStaffForm({ name: '', email: '', role: 'staff', password: '' })
        setShowAddStaffModal(false)
        showToast(`Сотрудник ${newMember.name} добавлен`)
    }

    const handleDeleteStaff = (id) => {
        if (window.confirm('Удалить сотрудника?')) {
            setStaff(staff.filter(s => s.id !== id))
            showToast('Сотрудник удалён')
        }
    }

    const handleResetPassword = () => {
        setShowResetPasswordModal(false)
        showToast(`Пароль для ${selectedStaff?.name} сброшен`)
        setSelectedStaff(null)
    }

    const handleAddCabinet = () => {
        if (!newCabinetForm.name || !newCabinetForm.email || !newCabinetForm.password) {
            showToast('Заполните все обязательные поля', 'error'); return
        }
        const newCabinet = {
            id: Date.now(), name: newCabinetForm.name, email: newCabinetForm.email, role: newCabinetForm.role,
            department: newCabinetForm.department, status: 'active', lastActive: 'Только что', avatar: newCabinetForm.name[0],
            phone: newCabinetForm.phone, location: newCabinetForm.location, workHours: newCabinetForm.workHours,
            joinedDate: new Date().toLocaleDateString('ru-RU'), permissions: newCabinetForm.permissions,
            maxConcurrentChats: newCabinetForm.maxConcurrentChats, canWithdraw: newCabinetForm.canWithdraw,
            canManageUsers: newCabinetForm.canManageUsers, canViewAnalytics: newCabinetForm.canViewAnalytics,
            canManageContent: newCabinetForm.canManageContent,
            stats: { totalChats: 0, resolvedTickets: 0, avgResponseTime: '0 мин', satisfactionRate: 0, monthlyMessages: 0, activeNow: false },
            activity: [], recentActions: [{ action: 'Кабинет создан', time: 'Только что', type: 'success' }],
        }
        setCabinets([...cabinets, newCabinet])
        setNewCabinetForm({ name: '', email: '', role: 'staff', password: '', department: 'support', permissions: ['chat', 'tickets'], phone: '', location: '', workHours: '9:00-18:00', maxConcurrentChats: 5, canWithdraw: false, canManageUsers: false, canViewAnalytics: false, canManageContent: false })
        setShowCabinetModal(false)
        showToast(`Личный кабинет для ${newCabinet.name} создан`)
    }

    const handleToggleCabinetStatus = (id) => {
        setCabinets(prev => prev.map(c => {
            if (c.id === id) {
                const newStatus = c.status === 'active' ? 'paused' : 'active'
                showToast(`Кабинет ${c.name} ${newStatus === 'active' ? 'активирован' : 'приостановлен'}`, newStatus === 'active' ? 'success' : 'warning')
                return { ...c, status: newStatus }
            }
            return c
        }))
    }

    const handleDeleteCabinet = (id) => {
        if (window.confirm('Удалить личный кабинет сотрудника? Все данные будут потеряны!')) {
            setCabinets(cabinets.filter(c => c.id !== id))
            showToast('Кабинет удалён')
        }
    }

    const handleImpersonate = (cabinet) => {
        showToast(`Вход в кабинет ${cabinet.name}...`, 'info')
    }

    const togglePermission = (permId) => {
        setNewCabinetForm(prev => {
            const perms = prev.permissions.includes(permId) ? prev.permissions.filter(p => p !== permId) : [...prev.permissions, permId]
            return { ...prev, permissions: perms }
        })
    }

    const handleWithdraw = () => {
        if (!withdrawForm.amount || parseFloat(withdrawForm.amount) <= 0) { showToast('Введите сумму', 'error'); return }
        if (!withdrawForm.account) { showToast('Введите реквизиты', 'error'); return }
        setShowWithdrawModal(false)
        showToast(`Вывод $${withdrawForm.amount} на ${withdrawForm.method.toUpperCase()} инициирован`)
        setWithdrawForm({ amount: '', method: 'wire', account: '' })
    }

    const handleSaveLegal = () => { showToast('Реквизиты сохранены') }

    const handleDownloadLegal = () => {
        const data = `AI Viral Studio LLC\nИНН: ${legalData.taxId}\nАдрес: ${legalData.address}\nР/с: ${legalData.account}\nБанк: ${legalData.bank}\nБИК: ${legalData.bik}\nSWIFT: ${legalData.swift}\nIBAN: ${legalData.iban}`.trim()
        const blob = new Blob([data], { type: 'text/plain' })
        const url = URL.createObjectURL(blob)
        const a = document.createElement('a')
        a.href = url; a.download = 'requisites_AI_Viral_Studio.txt'; a.click()
        URL.revokeObjectURL(url)
        showToast('Реквизиты скачаны')
    }

    const filteredCabinets = cabinets.filter(c => {
        if (cabinetFilter !== 'all' && c.status !== cabinetFilter) return false
        if (cabinetSearch && !c.name.toLowerCase().includes(cabinetSearch.toLowerCase()) && !c.email.toLowerCase().includes(cabinetSearch.toLowerCase())) return false
        return true
    })

    const getStatusColor = (status) => {
        switch (status) {
            case 'active': return 'bg-[#00ff41]/10 text-[#00ff41] border-[#00ff41]/20'
            case 'paused': return 'bg-yellow-500/10 text-yellow-400 border-yellow-500/20'
            case 'offline': return 'bg-gray-500/10 text-gray-400 border-gray-500/20'
            default: return 'bg-gray-500/10 text-gray-400'
        }
    }

    const getStatusDot = (status) => {
        switch (status) {
            case 'active': return 'bg-[#00ff41]'
            case 'paused': return 'bg-yellow-400'
            case 'offline': return 'bg-gray-500'
            default: return 'bg-gray-500'
        }
    }

    return (
        <div className="min-h-screen bg-[#0a0a0f] text-white">
            {toast && (
