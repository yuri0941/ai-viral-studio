    })

    const kpi = [
        { label: 'MRR', value: '$35,000', change: '+23%', positive: true },
        { label: 'Пользователи', value: '1,247', change: '+156', positive: true },
        { label: 'Конверсия', value: '12.4%', change: '+2.1%', positive: true },
        { label: 'Churn', value: '3.2%', change: '-0.8%', positive: true },
        { label: 'AI запросов/день', value: '45.2K', change: '+18%', positive: true },
        { label: 'Рекламный доход', value: '$8,400', change: '+34%', positive: true },
