                { date: '20 июл', chats: 68, tickets: 22, hours: 8.0 },
                { date: '19 июл', chats: 75, tickets: 28, hours: 9.0 },
                { date: '18 июл', chats: 65, tickets: 20, hours: 8.0 },
                { date: '17 июл', chats: 70, tickets: 24, hours: 8.5 },
                { date: '16 июл', chats: 63, tickets: 18, hours: 8.0 },
                { date: '15 июл', chats: 71, tickets: 26, hours: 8.5 },
