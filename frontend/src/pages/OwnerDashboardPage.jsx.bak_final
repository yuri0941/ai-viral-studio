    const departments = [
        { id: 'support', name: 'Поддержка', color: '#00ff41' },
        { id: 'content', name: 'Контент', color: '#2563eb' },
        { id: 'sales', name: 'Продажи', color: '#f0883e' },
        { id: 'tech', name: 'Технический', color: '#8b5cf6' },
        { id: 'marketing', name: 'Маркетинг', color: '#ec4899' },
