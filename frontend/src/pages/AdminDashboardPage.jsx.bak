import { useState } from 'react'
import { useAuth } from '../context/AuthContext'

function AdminDashboardPage() {
    const { user } = useAuth()
    const [users, setUsers] = useState([
        { id: 1, name: 'Иван Петров', email: 'ivan@mail.com', role: 'creator', status: 'active', posts: 45, joined: '2026-06-15' },
        { id: 2, name: 'Мария Сидорова', email: 'maria@mail.com', role: 'business', status: 'active', posts: 128, joined: '2026-05-20' },
        { id: 3, name: 'ООО Реклама', email: 'ads@company.ru', role: 'advertiser', status: 'banned', posts: 12, joined: '2026-07-01' },
        { id: 4, name: 'Алексей К.', email: 'alex@mail.com', role: 'creator', status: 'active', posts: 8, joined: '2026-07-10' },
        { id: 5, name: 'Test User', email: 'test@test.com', role: 'creator', status: 'pending', posts: 0, joined: '2026-07-20' }
    ])

    const platformStats = {
        totalUsers: 1247,
        activeToday: 89,
        newToday: 12,
        reportsPending: 5,
        totalPosts: 45620,
        revenue: 15400
    }

    const getRoleColor = (role) => {
        switch (role) {
            case 'owner': return 'bg-yellow-500/20 text-yellow-400'
            case 'admin': return 'bg-red-500/20 text-red-400'
            case 'staff': return 'bg-blue-500/20 text-blue-400'
            case 'advertiser': return 'bg-purple-500/20 text-purple-400'
            case 'business': return 'bg-orange-500/20 text-orange-400'
            default: return 'bg-[#00ff41]/20 text-[#00ff41]'
        }
    }

    const getStatusColor = (status) => {
        switch (status) {
            case 'active': return 'text-[#00ff41]'
            case 'banned': return 'text-red-400'
            case 'pending': return 'text-yellow-400'
            default: return 'text-gray-400'
        }
    }

    return (
        <div className="space-y-8">
            {/* Header */}
            <div className="flex items-center justify-between">
                <div>
                    <h1 className="text-3xl font-bold text-white mb-2">
                        Admin Panel 🛡️
                    </h1>
                    <p className="text-gray-400">Управление платформой и пользователями</p>
                </div>
                <div className="flex items-center gap-4">
                    <span className="px-4 py-2 rounded-full bg-red-500/20 text-red-400 text-sm font-semibold">
                        {user?.name || 'Admin'}
                    </span>
                    <button className="px-4 py-2 rounded-xl bg-[#00ff41] text-black font-semibold text-sm hover:bg-[#00ff41]/90">
                        ⚙️ Настройки
                    </button>
                </div>
            </div>

            {/* Platform Stats */}
            <div className="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-6 gap-4">
                {[
                    { label: 'Всего пользователей', value: platformStats.totalUsers.toLocaleString(), icon: '👥', color: 'text-blue-400' },
                    { label: 'Активны сегодня', value: platformStats.activeToday, icon: '🟢', color: 'text-[#00ff41]' },
                    { label: 'Новых сегодня', value: `+${platformStats.newToday}`, icon: '⭐', color: 'text-yellow-400' },
                    { label: 'Жалобы', value: platformStats.reportsPending, icon: '⚠️', color: 'text-red-400' },
                    { label: 'Всего постов', value: platformStats.totalPosts.toLocaleString(), icon: '📝', color: 'text-purple-400' },
                    { label: 'Доход', value: `$${platformStats.revenue.toLocaleString()}`, icon: '💰', color: 'text-[#00ff41]' }
                ].map((stat, i) => (
                    <div key={i} className="bg-white/5 border border-white/10 rounded-2xl p-4 text-center">
                        <span className="text-2xl mb-2 block">{stat.icon}</span>
                        <p className={`text-xl font-bold ${stat.color}`}>{stat.value}</p>
                        <p className="text-xs text-gray-400 mt-1">{stat.label}</p>
                    </div>
                ))}
            </div>

            {/* Users Management */}
            <div className="bg-white/5 border border-white/10 rounded-2xl overflow-hidden">
                <div className="p-6 border-b border-white/10 flex items-center justify-between">
                    <h2 className="text-xl font-semibold text-white">Пользователи</h2>
                    <div className="flex gap-2">
                        <input
                            type="text"
                            placeholder="Поиск..."
                            className="px-4 py-2 rounded-lg bg-white/5 border border-white/10 text-white text-sm focus:outline-none focus:border-[#00ff41]/30"
                        />
                        <button className="px-4 py-2 rounded-lg bg-[#00ff41] text-black text-sm font-semibold">
                            + Добавить
                        </button>
                    </div>
                </div>
                <div className="overflow-x-auto">
                    <table className="w-full">
                        <thead>
                            <tr className="text-left text-gray-500 text-sm border-b border-white/5">
                                <th className="p-4">ID</th>
                                <th className="p-4">Имя</th>
                                <th className="p-4">Email</th>
                                <th className="p-4">Роль</th>
                                <th className="p-4">Статус</th>
                                <th className="p-4">Постов</th>
                                <th className="p-4">Дата регистрации</th>
                                <th className="p-4">Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            {users.map((u) => (
                                <tr key={u.id} className="border-b border-white/5 hover:bg-white/5 transition-colors">
                                    <td className="p-4 text-gray-400">#{u.id}</td>
                                    <td className="p-4 text-white font-medium">{u.name}</td>
                                    <td className="p-4 text-gray-300">{u.email}</td>
                                    <td className="p-4">
                                        <span className={`px-2 py-1 rounded-full text-xs ${getRoleColor(u.role)}`}>
                                            {u.role}
                                        </span>
                                    </td>
                                    <td className="p-4">
                                        <span className={`text-sm font-semibold ${getStatusColor(u.status)}`}>
                                            {u.status === 'active' ? '✅ Активен' : u.status === 'banned' ? '🚫 Заблокирован' : '⏳ На модерации'}
                                        </span>
                                    </td>
                                    <td className="p-4 text-gray-300">{u.posts}</td>
                                    <td className="p-4 text-gray-500 text-sm">{u.joined}</td>
                                    <td className="p-4">
                                        <div className="flex gap-2">
                                            <button className="px-3 py-1 rounded-lg bg-blue-500/10 text-blue-400 text-sm hover:bg-blue-500/20">✏️</button>
                                            <button className="px-3 py-1 rounded-lg bg-yellow-500/10 text-yellow-400 text-sm hover:bg-yellow-500/20">🔒</button>
                                            <button className="px-3 py-1 rounded-lg bg-red-500/10 text-red-400 text-sm hover:bg-red-500/20">🗑️</button>
                                        </div>
                                    </td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            </div>

            {/* Quick Actions Grid */}
            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                {[
                    { label: 'Модерация контента', icon: '🛡️', desc: '5 жалоб на рассмотрении', color: 'from-red-500/20 to-red-600/10' },
                    { label: 'Системные логи', icon: '📋', desc: 'Последние ошибки', color: 'from-blue-500/20 to-blue-600/10' },
                    { label: 'Настройки платформы', icon: '⚙️', desc: 'API, лимиты, роли', color: 'from-[#00ff41]/20 to-[#00cc33]/10' },
                    { label: 'Финансы', icon: '💰', desc: 'Доходы и выплаты', color: 'from-yellow-500/20 to-yellow-600/10' }
                ].map((action, i) => (
                    <div key={i} className={`group relative overflow-hidden rounded-2xl p-6 bg-gradient-to-br ${action.color} border border-white/10 hover:border-white/20 transition-all cursor-pointer hover:scale-105`}>
                        <span className="text-3xl mb-3 block">{action.icon}</span>
                        <h3 className="text-white font-semibold mb-1">{action.label}</h3>
                        <p className="text-gray-400 text-sm">{action.desc}</p>
                    </div>
                ))}
            </div>
        </div>
    )
}

export default AdminDashboardPage