import { useState } from 'react'
import { useAuth } from '../context/AuthContext'

function AdvertiserDashboardPage() {
    const { user } = useAuth()
    const [showModal, setShowModal] = useState(false)
    const [campaigns, setCampaigns] = useState([
        { id: 1, name: 'Летняя распродажа', status: 'active', budget: 5000, spent: 3200, ctr: 3.2, impressions: 45000, clicks: 1440 },
        { id: 2, name: 'Запуск нового продукта', status: 'paused', budget: 10000, spent: 1500, ctr: 2.8, impressions: 12000, clicks: 336 },
        { id: 3, name: 'Брендовая кампания', status: 'ended', budget: 3000, spent: 3000, ctr: 4.1, impressions: 28000, clicks: 1148 }
    ])

    const [newCampaign, setNewCampaign] = useState({
        name: '',
        budget: '',
        target: '',
        description: ''
    })

    const totalStats = {
        totalSpent: 7700,
        totalImpressions: 85000,
        totalClicks: 2924,
        avgCtr: 3.4
    }

    const getStatusColor = (status) => {
        switch (status) {
            case 'active': return 'bg-[#00ff41]/20 text-[#00ff41]'
            case 'paused': return 'bg-yellow-500/20 text-yellow-400'
            case 'ended': return 'bg-gray-500/20 text-gray-400'
            default: return 'bg-gray-500/20 text-gray-400'
        }
    }

    const handleCreateCampaign = (e) => {
        e.preventDefault()
        const campaign = {
            id: campaigns.length + 1,
            name: newCampaign.name,
            status: 'active',
            budget: parseInt(newCampaign.budget) || 1000,
            spent: 0,
            ctr: 0,
            impressions: 0,
            clicks: 0
        }
        setCampaigns([...campaigns, campaign])
        setShowModal(false)
        setNewCampaign({ name: '', budget: '', target: '', description: '' })
    }

    return (
        <div className="space-y-8 relative">
            {/* Header */}
            <div className="flex items-center justify-between">
                <div>
                    <h1 className="text-3xl font-bold text-white mb-2">
                        Advertiser Panel 📢
                    </h1>
                    <p className="text-gray-400">Управление рекламными кампаниями</p>
                </div>
                <button
                    onClick={() => setShowModal(true)}
                    className="px-6 py-3 rounded-xl bg-[#00ff41] text-black font-semibold hover:bg-[#00ff41]/90 transition-colors"
                >
                    + Новая кампания
                </button>
            </div>

            {/* Stats */}
            <div className="grid grid-cols-1 md:grid-cols-4 gap-6">
                {[
                    { label: 'Потрачено', value: `$${totalStats.totalSpent.toLocaleString()}`, icon: '💰', color: 'text-[#00ff41]' },
                    { label: 'Показы', value: totalStats.totalImpressions.toLocaleString(), icon: '👁️', color: 'text-blue-400' },
                    { label: 'Клики', value: totalStats.totalClicks.toLocaleString(), icon: '🖱️', color: 'text-purple-400' },
                    { label: 'Средний CTR', value: `${totalStats.avgCtr}%`, icon: '📈', color: 'text-yellow-400' }
                ].map((stat, i) => (
                    <div key={i} className="bg-white/5 border border-white/10 rounded-2xl p-6">
                        <span className="text-2xl mb-2 block">{stat.icon}</span>
                        <p className="text-2xl font-bold text-white">{stat.value}</p>
                        <p className="text-sm text-gray-400">{stat.label}</p>
                    </div>
                ))}
            </div>

            {/* Campaigns */}
            <div className="bg-white/5 border border-white/10 rounded-2xl overflow-hidden">
                <div className="p-6 border-b border-white/10">
                    <h2 className="text-xl font-semibold text-white">Мои кампании</h2>
                </div>
                <div className="overflow-x-auto">
                    <table className="w-full">
                        <thead>
                            <tr className="text-left text-gray-500 text-sm border-b border-white/5">
                                <th className="p-4">Кампания</th>
                                <th className="p-4">Статус</th>
                                <th className="p-4">Бюджет</th>
                                <th className="p-4">Потрачено</th>
                                <th className="p-4">Показы</th>
                                <th className="p-4">Клики</th>
                                <th className="p-4">CTR</th>
                                <th className="p-4">Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            {campaigns.map((camp) => (
                                <tr key={camp.id} className="border-b border-white/5 hover:bg-white/5 transition-colors">
                                    <td className="p-4 text-white font-medium">{camp.name}</td>
                                    <td className="p-4">
                                        <span className={`px-2 py-1 rounded-full text-xs ${getStatusColor(camp.status)}`}>
                                            {camp.status === 'active' ? 'Активна' : camp.status === 'paused' ? 'Пауза' : 'Завершена'}
                                        </span>
                                    </td>
                                    <td className="p-4 text-gray-300">${camp.budget.toLocaleString()}</td>
                                    <td className="p-4 text-gray-300">${camp.spent.toLocaleString()}</td>
                                    <td className="p-4 text-gray-300">{camp.impressions.toLocaleString()}</td>
                                    <td className="p-4 text-gray-300">{camp.clicks.toLocaleString()}</td>
                                    <td className="p-4 text-[#00ff41] font-semibold">{camp.ctr}%</td>
                                    <td className="p-4">
                                        <div className="flex gap-2">
                                            <button className="px-3 py-1 rounded-lg bg-white/5 text-gray-300 text-sm hover:bg-white/10">📊</button>
                                            <button className="px-3 py-1 rounded-lg bg-white/5 text-gray-300 text-sm hover:bg-white/10">✏️</button>
                                        </div>
                                    </td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            </div>

            {/* Targeting & Tools */}
            <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <div className="bg-white/5 border border-white/10 rounded-2xl p-6">
                    <h2 className="text-xl font-semibold text-white mb-4">🎯 Аудитория</h2>
                    <div className="space-y-4">
                        {[
                            { label: 'Возраст', value: '18-35 лет', bar: 75 },
                            { label: 'Гео', value: 'Россия, СНГ', bar: 60 },
                            { label: 'Интересы', value: 'Технологии, Бизнес', bar: 85 }
                        ].map((item, i) => (
                            <div key={i}>
                                <div className="flex justify-between mb-2">
                                    <span className="text-gray-300 text-sm">{item.label}</span>
                                    <span className="text-gray-400 text-sm">{item.value}</span>
                                </div>
                                <div className="h-2 bg-white/10 rounded-full overflow-hidden">
                                    <div className="h-full bg-gradient-to-r from-[#00ff41] to-[#2563eb] rounded-full" style={{ width: `${item.bar}%` }} />
                                </div>
                            </div>
                        ))}
                    </div>
                </div>

                <div className="bg-white/5 border border-white/10 rounded-2xl p-6">
                    <h2 className="text-xl font-semibold text-white mb-4">💡 Рекомендации AI</h2>
                    <div className="space-y-4">
                        {[
                            'Увеличь бюджет на 20% для лучшего охвата в вечерние часы',
                            'Добавь видео-формат — CTR вырастет на 40%',
                            'Твоя аудитория активна в TikTok с 19:00 до 22:00'
                        ].map((tip, i) => (
                            <div key={i} className="p-4 rounded-xl bg-[#00ff41]/5 border border-[#00ff41]/10">
                                <p className="text-gray-300 text-sm">{tip}</p>
                            </div>
                        ))}
                    </div>
                </div>
            </div>

            {/* Modal */}
            {showModal && (
                <div className="fixed inset-0 bg-black/70 backdrop-blur-sm flex items-center justify-center z-50 p-4">
                    <div className="bg-[#0f0f1a] border border-white/10 rounded-2xl p-8 w-full max-w-lg">
                        <div className="flex items-center justify-between mb-6">
                            <h2 className="text-2xl font-bold text-white">🆕 Новая кампания</h2>
                            <button
                                onClick={() => setShowModal(false)}
                                className="text-gray-400 hover:text-white text-2xl"
                            >
                                ✕
                            </button>
                        </div>

                        <form onSubmit={handleCreateCampaign} className="space-y-4">
                            <div>
                                <label className="block text-sm text-gray-400 mb-2">Название кампании</label>
                                <input
                                    type="text"
                                    value={newCampaign.name}
                                    onChange={(e) => setNewCampaign({ ...newCampaign, name: e.target.value })}
                                    className="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:border-[#00ff41]/30"
                                    placeholder="Например: Летняя распродажа"
                                    required
                                />
                            </div>

                            <div>
                                <label className="block text-sm text-gray-400 mb-2">Бюджет ($)</label>
                                <input
                                    type="number"
                                    value={newCampaign.budget}
                                    onChange={(e) => setNewCampaign({ ...newCampaign, budget: e.target.value })}
                                    className="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:border-[#00ff41]/30"
                                    placeholder="5000"
                                    required
                                />
                            </div>

                            <div>
                                <label className="block text-sm text-gray-400 mb-2">Целевая аудитория</label>
                                <select
                                    value={newCampaign.target}
                                    onChange={(e) => setNewCampaign({ ...newCampaign, target: e.target.value })}
                                    className="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white focus:outline-none focus:border-[#00ff41]/30"
                                >
                                    <option value="" className="bg-[#0f0f1a]">Выберите аудиторию</option>
                                    <option value="18-25" className="bg-[#0f0f1a]">18-25 лет</option>
                                    <option value="25-35" className="bg-[#0f0f1a]">25-35 лет</option>
                                    <option value="35-50" className="bg-[#0f0f1a]">35-50 лет</option>
                                    <option value="50+" className="bg-[#0f0f1a]">50+ лет</option>
                                </select>
                            </div>

                            <div>
                                <label className="block text-sm text-gray-400 mb-2">Описание</label>
                                <textarea
                                    value={newCampaign.description}
                                    onChange={(e) => setNewCampaign({ ...newCampaign, description: e.target.value })}
                                    className="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:border-[#00ff41]/30 h-24 resize-none"
                                    placeholder="Опишите цели кампании..."
                                />
                            </div>

                            <div className="flex gap-4 pt-4">
                                <button
                                    type="button"
                                    onClick={() => setShowModal(false)}
                                    className="flex-1 py-3 rounded-xl bg-white/5 text-white hover:bg-white/10 transition-colors"
                                >
                                    Отмена
                                </button>
                                <button
                                    type="submit"
                                    className="flex-1 py-3 rounded-xl bg-[#00ff41] text-black font-semibold hover:bg-[#00ff41]/90 transition-colors"
                                >
                                    Создать кампанию
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            )}
        </div>
    )
}

export default AdvertiserDashboardPage