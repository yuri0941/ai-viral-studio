                                <div className="flex items-center justify-between mb-6">
                                    <h3 className="font-bold">Активные промо</h3>
                                    <select value={promoFilter} onChange={e => setPromoFilter(e.target.value)} className="px-4 py-2 bg-[#1a1a24] rounded-xl border border-white/10 text-sm text-white outline-none focus:border-[#00ff41]/30">
                                        <option value="all">Все</option><option value="active">Активные</option><option value="scheduled">Запланированные</option><option value="ended">Завершённые</option>
                                    </select>
                                </div>
                                <div className="space-y-3">
                                    {promotions.filter(p => promoFilter === 'all' || p.status === promoFilter).map(promo => (
                                        <div key={promo.id} className="p-4 rounded-xl bg-white/[0.02] border border-white/[0.04] hover:border-white/[0.08] transition-all">
                                            <div className="flex items-center justify-between mb-3">
                                                <div className="flex items-center gap-3">
                                                    <h4 className="font-semibold text-white">{promo.name}</h4>
                                                    <span className={`text-xs px-2 py-0.5 rounded-full border ${getPromoStatusColor(promo.status)}`}>{promo.status === 'active' ? 'Активно' : promo.status === 'scheduled' ? 'Запланировано' : 'Завершено'}</span>
                                                    <span className={`text-xs px-2 py-0.5 rounded-full border ${promo.type === 'discount' ? 'bg-purple-500/10 text-purple-400 border-purple-500/20' : promo.type === 'referral' ? 'bg-blue-500/10 text-blue-400 border-blue-500/20' : 'bg-orange-500/10 text-orange-400 border-orange-500/20'}`}>{promo.type === 'discount' ? 'Скидка' : promo.type === 'referral' ? 'Реферал' : 'Giveaway'}</span>
                                                </div>
                                                <div className="flex items-center gap-1">
                                                    <button onClick={() => showToast('Код скопирован')} className="p-2 rounded-lg hover:bg-white/5 text-gray-400 hover:text-white transition-all"><Copy size={14} /></button>
                                                    <button onClick={() => showToast('Промо удалено')} className="p-2 rounded-lg hover:bg-white/5 text-gray-400 hover:text-red-400 transition-all"><Trash2 size={14} /></button>
                                                </div>
                                            </div>
                                            <div className="flex items-center gap-4 text-sm mb-2">
                                                <span className="px-3 py-1 bg-[#00ff41]/10 text-[#00ff41] font-mono rounded-lg border border-[#00ff41]/20 text-xs">{promo.code}</span>
                                                <span className="text-gray-400">{promo.value}</span>
                                                <span className="text-gray-500">{promo.startDate} — {promo.endDate}</span>
                                            </div>
                                            <div className="flex items-center gap-2">
                                                <span className="text-xs text-gray-500">Использований: {promo.usage} / {promo.maxUsage}</span>
                                                <div className="flex-1 h-1.5 bg-white/5 rounded-full overflow-hidden max-w-[150px]">
                                                    <div className="h-full bg-[#00ff41] rounded-full" style={{ width: `${(promo.usage / promo.maxUsage) * 100}%` }} />
                                                </div>
                                                <span className="text-xs text-[#00ff41]">{Math.round((promo.usage / promo.maxUsage) * 100)}%</span>
                                            </div>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        </div>
                    )}

                    {/* NEWS TAB */}
                    {activeTab === 'news' && (
                        <div className="space-y-6">
                            <div className="glass rounded-2xl p-6 border-white/5">
                                <div className="flex items-center justify-between mb-6">
                                    <h3 className="font-bold text-lg flex items-center gap-2"><Newspaper className="w-5 h-5 text-[#00ff41]" /> Новости и сообщество</h3>
                                    <button onClick={() => showToast('Редактор новостей')} className="flex items-center gap-2 px-4 py-2 bg-[#00ff41] hover:bg-[#00cc33] text-black font-semibold rounded-xl transition-all hover:scale-[1.02] text-sm">
                                        <Plus size={16} /> Добавить новость
                                    </button>
                                </div>
                                <div className="bg-white/[0.02] border border-white/[0.04] rounded-2xl p-5">
                                    <h4 className="text-white font-medium mb-3 flex items-center gap-2"><Send className="w-4 h-4 text-[#00ff41]" /> Опубликовать в Telegram</h4>
                                    <div className="space-y-3">
                                        <input type="text" placeholder="Заголовок новости..." className="w-full bg-[#1a1a24] border border-white/10 rounded-xl px-4 py-2.5 text-white focus:border-[#00ff41]/30 outline-none text-sm" />
                                        <textarea placeholder="Текст новости... Поддерживается Markdown" className="w-full bg-[#1a1a24] border border-white/10 rounded-xl px-4 py-3 text-white focus:border-[#00ff41]/30 outline-none text-sm h-24 resize-none" />
                                        <div className="flex gap-3 flex-wrap">
                                            <button onClick={() => showToast('Изображение добавлено')} className="flex items-center gap-2 px-3 py-2 bg-[#1a1a24] border border-white/10 rounded-lg text-xs text-gray-400 hover:text-white transition-all">
                                                <ImageIcon className="w-4 h-4" /> Добавить изображение
                                            </button>
                                            <button onClick={() => showToast('Ссылка добавлена')} className="flex items-center gap-2 px-3 py-2 bg-[#1a1a24] border border-white/10 rounded-lg text-xs text-gray-400 hover:text-white transition-all">
                                                <Link2 className="w-4 h-4" /> Добавить ссылку
                                            </button>
                                            <button onClick={() => showToast('Упоминание добавлено')} className="flex items-center gap-2 px-3 py-2 bg-[#1a1a24] border border-white/10 rounded-lg text-xs text-gray-400 hover:text-white transition-all">
                                                <AtSign className="w-4 h-4" /> Упоминание
                                            </button>
                                        </div>
                                        <button onClick={() => showToast('Опубликовано в Telegram')} className="w-full py-2.5 bg-[#00ff41] hover:bg-[#00cc33] text-black rounded-xl text-sm font-semibold transition-all hover:scale-[1.02]">
                                            Опубликовать в Telegram канал
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div className="space-y-4">
                                {newsItems.map(n => (
                                    <div key={n.id} className="glass rounded-2xl overflow-hidden border border-white/5 hover:border-white/[0.1] transition-all">
                                        <div className="h-48 bg-[#1a1a24] overflow-hidden">
                                            <img src={n.image} alt="" className="w-full h-full object-cover opacity-80 hover:opacity-100 transition-opacity" />
                                        </div>
                                        <div className="p-5">
                                            <div className="flex items-center gap-2 mb-2">
                                                <span className={`px-2 py-0.5 rounded-lg text-xs border ${n.type === 'update' ? 'bg-[#00ff41]/10 text-[#00ff41] border-[#00ff41]/20' : 'bg-blue-500/10 text-blue-400 border-blue-500/20'}`}>
                                                    {n.type === 'update' ? 'Обновление' : 'Достижение'}
                                                </span>
                                                <span className="text-gray-500 text-xs">{n.date}</span>
                                            </div>
                                            <h4 className="text-white font-semibold mb-2">{n.title}</h4>
                                            <p className="text-gray-400 text-sm">{n.content}</p>
                                            <div className="flex gap-2 mt-4">
                                                <button onClick={() => showToast('Редактирование')} className="px-3 py-1.5 bg-[#1a1a24] border border-white/10 rounded-lg text-xs text-gray-400 hover:text-white transition-all">Редактировать</button>
                                                <button onClick={() => showToast('Статистика')} className="px-3 py-1.5 bg-[#1a1a24] border border-white/10 rounded-lg text-xs text-gray-400 hover:text-white transition-all">Статистика</button>
                                                <button onClick={() => showToast('Новость удалена')} className="px-3 py-1.5 bg-red-500/10 border border-red-500/20 rounded-lg text-xs text-red-400 hover:bg-red-500/20 transition-all">Удалить</button>
                                            </div>
                                        </div>
                                    </div>
                                ))}
                            </div>
                        </div>
                    )}

                    {/* REFERRALS TAB */}
                    {activeTab === 'referrals' && (
                        <div className="space-y-6">
                            <div className="grid grid-cols-2 lg:grid-cols-4 gap-4">
                                {[
                                    { label: 'Всего рефералов', value: '1,245', icon: Share2 },
                                    { label: 'Конверсии', value: '456', icon: UserCheck },
                                    { label: 'Доход', value: '$12,450', icon: DollarSign },
                                    { label: 'Активные коды', value: '12', icon: Tag },
                                ].map((s, i) => (
                                    <div key={i} className="glass rounded-2xl p-5 border border-white/5">
                                        <s.icon className="w-5 h-5 text-[#00ff41] mb-2" />
                                        <div className="text-2xl font-bold text-white">{s.value}</div>
                                        <div className="text-gray-500 text-xs">{s.label}</div>
                                    </div>
                                ))}
                            </div>

                            <div className="glass rounded-2xl p-6 border-white/5">
                                <div className="flex items-center justify-between mb-4">
                                    <h3 className="font-bold text-lg flex items-center gap-2"><Gift className="w-5 h-5 text-[#00ff41]" /> Создать реферальную программу</h3>
                                </div>
                                <div className="grid grid-cols-1 lg:grid-cols-3 gap-4">
                                    <div>
                                        <label className="block text-sm text-gray-400 mb-2">Название промо</label>
                                        <input type="text" placeholder="Приведи друга — получи бонус" className="w-full px-4 py-2.5 bg-[#1a1a24] rounded-xl border border-white/10 text-white focus:border-[#00ff41]/30 outline-none text-sm" />
                                    </div>
                                    <div>
                                        <label className="block text-sm text-gray-400 mb-2">Тип бонуса</label>
                                        <select className="w-full px-4 py-2.5 bg-[#1a1a24] rounded-xl border border-white/10 text-white focus:border-[#00ff41]/30 outline-none text-sm">
                                            <option value="analysis">+3 Анализа</option>
                                            <option value="chat">+10 Viral Chat</option>
                                            <option value="discount">50% скидка</option>
                                            <option value="month">1 месяц Pro</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label className="block text-sm text-gray-400 mb-2">Реферальный код</label>
                                        <div className="flex gap-2">
                                            <input type="text" placeholder="FRIEND2026" className="flex-1 px-4 py-2.5 bg-[#1a1a24] rounded-xl border border-white/10 text-white focus:border-[#00ff41]/30 outline-none text-sm font-mono" />
                                            <button onClick={() => showToast('Код обновлён')} className="px-3 py-2 bg-[#1a1a24] border border-white/10 rounded-lg text-gray-400 hover:text-[#00ff41] transition-all">
                                                <RefreshCw className="w-4 h-4" />
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                <div className="mt-4">
                                    <label className="block text-sm text-gray-400 mb-2">Условия (все тарифы)</label>
                                    <div className="p-4 rounded-xl bg-white/[0.02] text-sm text-gray-400 border border-white/[0.04]">
                                        При регистрации по реферальной ссылке, <span className="text-[#00ff41]">и реферал, и пригласивший</span> получают бонус в зависимости от тарифа:
                                        <ul className="mt-3 space-y-1.5 text-xs">
                                            <li className="flex items-center gap-2"><Check size={12} className="text-[#00ff41]" /><b>Free</b> → +2 Анализа, +5 Viral Chat</li>
                                            <li className="flex items-center gap-2"><Check size={12} className="text-[#00ff41]" /><b>Pro</b> → +3 Анализа, +10 Viral Chat</li>
                                            <li className="flex items-center gap-2"><Check size={12} className="text-[#00ff41]" /><b>Agency</b> → +5 Анализов, +20 Viral Chat</li>
                                            <li className="flex items-center gap-2"><Check size={12} className="text-[#00ff41]" /><b>Enterprise</b> → +10 Анализов, +50 Viral Chat</li>
                                        </ul>
                                    </div>
                                </div>
                                <button onClick={() => showToast('Реферальная ссылка сгенерирована')} className="mt-4 w-full py-2.5 bg-[#00ff41] hover:bg-[#00cc33] text-black rounded-xl text-sm font-semibold transition-all hover:scale-[1.02]">
                                    Сгенерировать реферальную ссылку
                                </button>
                            </div>

                            <div className="glass rounded-2xl p-6 border-white/5">
                                <div className="flex items-center justify-between mb-6">
                                    <h3 className="font-bold flex items-center gap-2"><Tag className="w-5 h-5 text-[#00ff41]" /> Активные реферальные коды</h3>
                                    <select value={referralFilter} onChange={e => setReferralFilter(e.target.value)} className="px-4 py-2 bg-[#1a1a24] rounded-xl border border-white/10 text-sm text-white outline-none focus:border-[#00ff41]/30">
                                        <option value="all">Все</option><option value="active">Активные</option><option value="paused">Приостановленные</option>
                                    </select>
                                </div>
                                <div className="space-y-3">
                                    {referrals.filter(r => referralFilter === 'all' || r.status === referralFilter).map(r => (
                                        <div key={r.id} className="p-4 rounded-xl bg-white/[0.02] border border-white/[0.04]">
                                            <div className="flex items-center justify-between mb-3">
                                                <div className="flex items-center gap-3">
                                                    <span className="px-3 py-1 bg-[#00ff41]/10 text-[#00ff41] font-mono text-sm rounded-lg border border-[#00ff41]/20">{r.code}</span>
                                                    <span className={`px-2 py-0.5 rounded-lg border text-xs ${getReferralStatusColor(r.status)}`}>{getReferralStatusText(r.status)}</span>
                                                </div>
                                                <div className="flex gap-1">
                                                    <button onClick={() => showToast('Код скопирован')} className="p-2 bg-[#1a1a24] border border-white/10 rounded-lg text-gray-400 hover:text-[#00ff41] transition-all">
                                                        <Copy className="w-3 h-3" />
                                                    </button>
                                                    <button onClick={() => showToast('Статус изменён')} className="p-2 bg-[#1a1a24] border border-white/10 rounded-lg text-gray-400 hover:text-yellow-400 transition-all">
                                                        {r.status === 'active' ? <EyeOff className="w-3 h-3" /> : <Eye className="w-3 h-3" />}
                                                    </button>
                                                </div>
                                            </div>
                                            <div className="grid grid-cols-2 lg:grid-cols-4 gap-4 text-sm">
                                                <div><div className="text-gray-500 text-xs">Тип</div><div className="text-white capitalize">{r.type}</div></div>
                                                <div><div className="text-gray-500 text-xs">Бонус</div><div className="text-[#00ff41]">{r.bonus}</div></div>
                                                <div><div className="text-gray-500 text-xs">Использований</div><div className="text-white">{r.usage}</div></div>
                                                <div><div className="text-gray-500 text-xs">Конверсии</div><div className="text-white">{r.conversions} ({Math.round(r.conversions/r.usage*100)}%)</div></div>
                                            </div>
                                            <div className="mt-2 text-gray-500 text-xs">Доход: <span className="text-white">{r.revenue}</span></div>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        </div>
                    )}
                </div>
            </main>

            {/* ===== MODALS ===== */}
            {showAddStaffModal && (
                <div className="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center p-4">
                    <div className="bg-[#1a1a24] rounded-2xl border border-white/10 w-full max-w-md">
                        <div className="p-6">
                            <div className="flex items-center justify-between mb-6">
                                <h2 className="text-xl font-bold flex items-center gap-2"><UserPlus size={20} /> Добавить сотрудника</h2>
                                <button onClick={() => setShowAddStaffModal(false)} className="text-gray-400 hover:text-white"><X size={20} /></button>
                            </div>
                            <div className="space-y-4">
                                <div><label className="text-sm text-gray-400 mb-1 block">Имя</label><input type="text" value={newStaffForm.name} onChange={e => setNewStaffForm({ ...newStaffForm, name: e.target.value })} placeholder="Иван Иванов" className="w-full px-4 py-2 bg-[#252530] rounded-lg border border-white/10 focus:border-emerald-500 outline-none" /></div>
                                <div><label className="text-sm text-gray-400 mb-1 block">Email</label><input type="email" value={newStaffForm.email} onChange={e => setNewStaffForm({ ...newStaffForm, email: e.target.value })} placeholder="ivan@ai-viral.com" className="w-full px-4 py-2 bg-[#252530] rounded-lg border border-white/10 focus:border-emerald-500 outline-none" /></div>
                                <div><label className="text-sm text-gray-400 mb-1 block">Роль</label><select value={newStaffForm.role} onChange={e => setNewStaffForm({ ...newStaffForm, role: e.target.value })} className="w-full px-4 py-2 bg-[#252530] rounded-lg border border-white/10 focus:border-emerald-500 outline-none"><option value="staff">Staff</option><option value="admin">Admin</option><option value="creator">Creator</option><option value="advertiser">Advertiser</option><option value="business">Business</option></select></div>
                                <div><label className="text-sm text-gray-400 mb-1 block">Пароль</label><div className="relative"><input type={showPassword ? "text" : "password"} value={newStaffForm.password} onChange={e => setNewStaffForm({ ...newStaffForm, password: e.target.value })} placeholder="Минимум 6 символов" className="w-full px-4 py-2 bg-[#252530] rounded-lg border border-white/10 focus:border-emerald-500 outline-none pr-10" /><button onClick={() => setShowPassword(!showPassword)} className="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-white">{showPassword ? <EyeOff size={16} /> : <Eye size={16} />}</button></div></div>
                            </div>
                            <div className="flex gap-3 mt-6">
                                <button onClick={() => setShowAddStaffModal(false)} className="flex-1 px-4 py-2 bg-[#252530] rounded-lg hover:bg-[#303040] transition-colors">Отмена</button>
                                <button onClick={handleAddStaff} disabled={!newStaffForm.name || !newStaffForm.email || !newStaffForm.password} className="flex-1 px-4 py-2 bg-emerald-500 hover:bg-emerald-600 disabled:bg-gray-600 text-black font-medium rounded-lg transition-all">Добавить</button>
                            </div>
                        </div>
                    </div>
                </div>
            )}

            {showResetPasswordModal && selectedStaff && (
                <div className="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center p-4">
                    <div className="bg-[#1a1a24] rounded-2xl border border-white/10 w-full max-w-sm">
                        <div className="p-6 text-center">
                            <div className="w-12 h-12 rounded-full bg-yellow-500/10 flex items-center justify-center mx-auto mb-4"><KeyRound size={24} className="text-yellow-400" /></div>
                            <h2 className="text-xl font-bold mb-2">Сбросить пароль?</h2>
                            <p className="text-gray-400 text-sm mb-6">Новый пароль будет отправлен на {selectedStaff.email}</p>
                            <div className="flex gap-3">
                                <button onClick={() => setShowResetPasswordModal(false)} className="flex-1 px-4 py-2 bg-[#252530] rounded-lg hover:bg-[#303040] transition-colors">Отмена</button>
                                <button onClick={handleResetPassword} className="flex-1 px-4 py-2 bg-yellow-500 hover:bg-yellow-600 text-black font-medium rounded-lg transition-all">Сбросить</button>
                            </div>
                        </div>
                    </div>
                </div>
            )}

            {showWithdrawModal && (
                <div className="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center p-4">
                    <div className="bg-[#1a1a24] rounded-2xl border border-white/10 w-full max-w-md">
                        <div className="p-6">
                            <div className="flex items-center justify-between mb-6">
                                <h2 className="text-xl font-bold flex items-center gap-2"><Wallet size={20} /> Вывод средств</h2>
                                <button onClick={() => setShowWithdrawModal(false)} className="text-gray-400 hover:text-white"><X size={20} /></button>
                            </div>
                            <div className="bg-emerald-500/10 rounded-lg p-4 mb-4 border border-emerald-500/20"><p className="text-sm text-gray-400">Доступно для вывода</p><p className="text-2xl font-bold text-emerald-400">$47,250</p></div>
                            <div className="space-y-4">
                                <div><label className="text-sm text-gray-400 mb-1 block">Сумма</label><input type="number" value={withdrawForm.amount} onChange={e => setWithdrawForm({ ...withdrawForm, amount: e.target.value })} placeholder="1000" className="w-full px-4 py-2 bg-[#252530] rounded-lg border border-white/10 focus:border-emerald-500 outline-none" /></div>
                                <div><label className="text-sm text-gray-400 mb-1 block">Способ вывода</label><select value={withdrawForm.method} onChange={e => setWithdrawForm({ ...withdrawForm, method: e.target.value })} className="w-full px-4 py-2 bg-[#252530] rounded-lg border border-white/10 focus:border-emerald-500 outline-none"><option value="wire">Wire Transfer</option><option value="paypal">PayPal</option><option value="crypto">Crypto (USDT)</option><option value="card">Банковская карта</option></select></div>
                                <div><label className="text-sm text-gray-400 mb-1 block">Реквизиты</label><input type="text" value={withdrawForm.account} onChange={e => setWithdrawForm({ ...withdrawForm, account: e.target.value })} placeholder="Счёт / Кошелёк / Карта" className="w-full px-4 py-2 bg-[#252530] rounded-lg border border-white/10 focus:border-emerald-500 outline-none" /></div>
                            </div>
                            <div className="flex gap-3 mt-6">
                                <button onClick={() => setShowWithdrawModal(false)} className="flex-1 px-4 py-2 bg-[#252530] rounded-lg hover:bg-[#303040] transition-colors">Отмена</button>
                                <button onClick={handleWithdraw} disabled={!withdrawForm.amount || !withdrawForm.account} className="flex-1 px-4 py-2 bg-emerald-500 hover:bg-emerald-600 disabled:bg-gray-600 text-black font-medium rounded-lg transition-all">Вывести</button>
                            </div>
                        </div>
                    </div>
                </div>
            )}

            {/* CREATE CABINET MODAL */}
            {showCabinetModal && (
                <div className="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center p-4 overflow-y-auto">
                    <div className="bg-[#1a1a24] rounded-2xl border border-white/10 w-full max-w-2xl my-8">
                        <div className="p-6">
                            <div className="flex items-center justify-between mb-6">
                                <h2 className="text-xl font-bold flex items-center gap-2"><Building2 size={20} /> Создать личный кабинет</h2>
                                <button onClick={() => setShowCabinetModal(false)} className="text-gray-400 hover:text-white"><X size={20} /></button>
                            </div>
                            <div className="grid lg:grid-cols-2 gap-4">
                                <div><label className="text-sm text-gray-400 mb-1 block">Имя сотрудника *</label><input type="text" value={newCabinetForm.name} onChange={e => setNewCabinetForm({ ...newCabinetForm, name: e.target.value })} placeholder="Иван Иванов" className="w-full px-4 py-2 bg-[#252530] rounded-lg border border-white/10 focus:border-[#00ff41] outline-none" /></div>
                                <div><label className="text-sm text-gray-400 mb-1 block">Email кабинета *</label><input type="email" value={newCabinetForm.email} onChange={e => setNewCabinetForm({ ...newCabinetForm, email: e.target.value })} placeholder="ivan.cabinet@ai-viral.com" className="w-full px-4 py-2 bg-[#252530] rounded-lg border border-white/10 focus:border-[#00ff41] outline-none" /></div>
                                <div><label className="text-sm text-gray-400 mb-1 block">Роль</label><select value={newCabinetForm.role} onChange={e => setNewCabinetForm({ ...newCabinetForm, role: e.target.value })} className="w-full px-4 py-2 bg-[#252530] rounded-lg border border-white/10 focus:border-[#00ff41] outline-none"><option value="staff">Staff</option><option value="admin">Admin</option><option value="creator">Creator</option><option value="advertiser">Advertiser</option></select></div>
                                <div><label className="text-sm text-gray-400 mb-1 block">Отдел</label><select value={newCabinetForm.department} onChange={e => setNewCabinetForm({ ...newCabinetForm, department: e.target.value })} className="w-full px-4 py-2 bg-[#252530] rounded-lg border border-white/10 focus:border-[#00ff41] outline-none">{departments.map(d => (<option key={d.id} value={d.id}>{d.name}</option>))}</select></div>
                                <div><label className="text-sm text-gray-400 mb-1 block">Телефон</label><input type="tel" value={newCabinetForm.phone} onChange={e => setNewCabinetForm({ ...newCabinetForm, phone: e.target.value })} placeholder="+7 (999) 123-45-67" className="w-full px-4 py-2 bg-[#252530] rounded-lg border border-white/10 focus:border-[#00ff41] outline-none" /></div>
                                <div><label className="text-sm text-gray-400 mb-1 block">Локация</label><input type="text" value={newCabinetForm.location} onChange={e => setNewCabinetForm({ ...newCabinetForm, location: e.target.value })} placeholder="Москва, РФ" className="w-full px-4 py-2 bg-[#252530] rounded-lg border border-white/10 focus:border-[#00ff41] outline-none" /></div>
                                <div><label className="text-sm text-gray-400 mb-1 block">Рабочие часы</label><input type="text" value={newCabinetForm.workHours} onChange={e => setNewCabinetForm({ ...newCabinetForm, workHours: e.target.value })} placeholder="9:00-18:00" className="w-full px-4 py-2 bg-[#252530] rounded-lg border border-white/10 focus:border-[#00ff41] outline-none" /></div>
                                <div><label className="text-sm text-gray-400 mb-1 block">Пароль *</label><div className="relative"><input type={showPassword ? "text" : "password"} value={newCabinetForm.password} onChange={e => setNewCabinetForm({ ...newCabinetForm, password: e.target.value })} placeholder="Минимум 8 символов" className="w-full px-4 py-2 bg-[#252530] rounded-lg border border-white/10 focus:border-[#00ff41] outline-none pr-10" /><button onClick={() => setShowPassword(!showPassword)} className="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-white">{showPassword ? <EyeOff size={16} /> : <Eye size={16} />}</button></div></div>
                            </div>

                            <div className="mt-6">
                                <label className="text-sm text-gray-400 mb-2 block">Права доступа</label>
                                <div className="grid grid-cols-2 sm:grid-cols-3 gap-2">
                                    {allPermissions.map(perm => {
                                        const Icon = perm.icon
                                        const isSelected = newCabinetForm.permissions.includes(perm.id)
                                        return (
                                            <button key={perm.id} onClick={() => togglePermission(perm.id)} className={`flex items-center gap-2 px-3 py-2 rounded-lg border text-xs transition-all ${isSelected ? 'border-[#00ff41] bg-[#00ff41]/10 text-white' : 'border-white/10 bg-[#252530] text-gray-400 hover:border-white/20'}`}>
                                                <Icon size={14} />{perm.name}{isSelected && <Check size={12} className="ml-auto text-[#00ff41]" />}
                                            </button>
                                        )
                                    })}
                                </div>
                            </div>

                            <div className="mt-6 grid grid-cols-2 gap-4">
                                <div className="flex items-center gap-3 p-3 rounded-lg bg-[#252530] border border-white/10">
                                    <input type="checkbox" id="canWithdraw" checked={newCabinetForm.canWithdraw} onChange={e => setNewCabinetForm({ ...newCabinetForm, canWithdraw: e.target.checked })} className="w-4 h-4 rounded border-white/20 bg-[#1a1a24] text-[#00ff41]" />
                                    <label htmlFor="canWithdraw" className="text-sm cursor-pointer">Может выводить средства</label>
                                </div>
                                <div className="flex items-center gap-3 p-3 rounded-lg bg-[#252530] border border-white/10">
                                    <input type="checkbox" id="canManageUsers" checked={newCabinetForm.canManageUsers} onChange={e => setNewCabinetForm({ ...newCabinetForm, canManageUsers: e.target.checked })} className="w-4 h-4 rounded border-white/20 bg-[#1a1a24] text-[#00ff41]" />
                                    <label htmlFor="canManageUsers" className="text-sm cursor-pointer">Управление пользователями</label>
                                </div>
                                <div className="flex items-center gap-3 p-3 rounded-lg bg-[#252530] border border-white/10">
                                    <input type="checkbox" id="canViewAnalytics" checked={newCabinetForm.canViewAnalytics} onChange={e => setNewCabinetForm({ ...newCabinetForm, canViewAnalytics: e.target.checked })} className="w-4 h-4 rounded border-white/20 bg-[#1a1a24] text-[#00ff41]" />
                                    <label htmlFor="canViewAnalytics" className="text-sm cursor-pointer">Просмотр аналитики</label>
                                </div>
                                <div className="flex items-center gap-3 p-3 rounded-lg bg-[#252530] border border-white/10">
                                    <input type="checkbox" id="canManageContent" checked={newCabinetForm.canManageContent} onChange={e => setNewCabinetForm({ ...newCabinetForm, canManageContent: e.target.checked })} className="w-4 h-4 rounded border-white/20 bg-[#1a1a24] text-[#00ff41]" />
                                    <label htmlFor="canManageContent" className="text-sm cursor-pointer">Управление контентом</label>
                                </div>
                            </div>

                            <div className="flex gap-3 mt-6">
                                <button onClick={() => setShowCabinetModal(false)} className="flex-1 px-4 py-2 bg-[#252530] rounded-lg hover:bg-[#303040] transition-colors">Отмена</button>
                                <button onClick={handleAddCabinet} disabled={!newCabinetForm.name || !newCabinetForm.email || !newCabinetForm.password} className="flex-1 px-4 py-2 bg-[#00ff41] hover:bg-[#00cc33] disabled:bg-gray-600 text-black font-medium rounded-lg transition-all">Создать кабинет</button>
                            </div>
                        </div>
                    </div>
                </div>
            )}

            {/* CABINET DETAILS MODAL */}
            {showCabinetDetailsModal && selectedCabinet && (
                <div className="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center p-4 overflow-y-auto">
                    <div className="bg-[#1a1a24] rounded-2xl border border-white/10 w-full max-w-3xl my-8">
                        <div className="p-6">
                            <div className="flex items-center justify-between mb-6">
                                <div className="flex items-center gap-3">
                                    <div className="w-14 h-14 rounded-xl bg-gradient-to-br from-[#2563eb] to-[#7c3aed] flex items-center justify-center text-2xl font-bold">{selectedCabinet.avatar}</div>
                                    <div>
                                        <h2 className="text-xl font-bold">{selectedCabinet.name}</h2>
                                        <p className="text-sm text-gray-400">{selectedCabinet.email}</p>
                                        <div className="flex items-center gap-2 mt-1">
                                            <span className={`text-[10px] px-2 py-0.5 rounded-full border ${getStatusColor(selectedCabinet.status)}`}>{selectedCabinet.status === 'active' ? 'Активен' : 'Приостановлен'}</span>
                                            <span className="text-[10px] text-gray-500">{selectedCabinet.stats.activeNow ? '🟢 Онлайн' : '⚫ Оффлайн'}</span>
                                        </div>
                                    </div>
                                </div>
                                <button onClick={() => setShowCabinetDetailsModal(false)} className="text-gray-400 hover:text-white"><X size={20} /></button>
                            </div>

                            <div className="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-6">
                                <div className="p-3 rounded-xl bg-white/[0.02] border border-white/[0.04]"><p className="text-xs text-gray-500">Всего чатов</p><p className="text-xl font-bold text-white">{selectedCabinet.stats.totalChats}</p></div>
                                <div className="p-3 rounded-xl bg-white/[0.02] border border-white/[0.04]"><p className="text-xs text-gray-500">Тикетов решено</p><p className="text-xl font-bold text-[#00ff41]">{selectedCabinet.stats.resolvedTickets}</p></div>
                                <div className="p-3 rounded-xl bg-white/[0.02] border border-white/[0.04]"><p className="text-xs text-gray-500">Средний ответ</p><p className="text-xl font-bold text-blue-400">{selectedCabinet.stats.avgResponseTime}</p></div>
                                <div className="p-3 rounded-xl bg-white/[0.02] border border-white/[0.04]"><p className="text-xs text-gray-500">CSAT</p><p className="text-xl font-bold text-purple-400">{selectedCabinet.stats.satisfactionRate}%</p></div>
                            </div>

                            <div className="grid lg:grid-cols-2 gap-6 mb-6">
                                <div>
                                    <h3 className="text-sm font-semibold mb-3 text-gray-300">Контактная информация</h3>
                                    <div className="space-y-2 text-sm">
                                        <div className="flex items-center gap-2 text-gray-400"><Phone size={14} />{selectedCabinet.phone || 'Не указан'}</div>
                                        <div className="flex items-center gap-2 text-gray-400"><MapPin size={14} />{selectedCabinet.location || 'Не указана'}</div>
                                        <div className="flex items-center gap-2 text-gray-400"><Clock size={14} />{selectedCabinet.workHours}</div>
                                        <div className="flex items-center gap-2 text-gray-400"><Calendar size={14} />Присоединился: {selectedCabinet.joinedDate}</div>
                                    </div>
                                </div>
                                <div>
                                    <h3 className="text-sm font-semibold mb-3 text-gray-300">Права доступа</h3>
                                    <div className="flex flex-wrap gap-1.5">
                                        {selectedCabinet.permissions.map(perm => {
                                            const permInfo = allPermissions.find(p => p.id === perm)
                                            return <span key={perm} className="text-[10px] px-2 py-0.5 rounded-full bg-[#00ff41]/10 text-[#00ff41] border border-[#00ff41]/20">{permInfo?.name || perm}</span>
                                        })}
                                    </div>
                                    <div className="mt-3 space-y-1 text-xs text-gray-500">
                                        {selectedCabinet.canWithdraw && <div className="flex items-center gap-1"><Check size={10} className="text-[#00ff41]" /> Может выводить средства</div>}
                                        {selectedCabinet.canManageUsers && <div className="flex items-center gap-1"><Check size={10} className="text-[#00ff41]" /> Управление пользователями</div>}
                                        {selectedCabinet.canViewAnalytics && <div className="flex items-center gap-1"><Check size={10} className="text-[#00ff41]" /> Просмотр аналитики</div>}
                                        {selectedCabinet.canManageContent && <div className="flex items-center gap-1"><Check size={10} className="text-[#00ff41]" /> Управление контентом</div>}
                                    </div>
                                </div>
                            </div>

                            <div className="mb-6">
                                <h3 className="text-sm font-semibold mb-3 text-gray-300">Активность за 7 дней</h3>
                                <div className="flex items-end gap-2 h-20">
                                    {selectedCabinet.activity.map((day, i) => (
                                        <div key={i} className="flex-1 flex flex-col items-center gap-1">
                                            <div className="w-full flex gap-0.5">
                                                <div className="flex-1 bg-[#00ff41]/30 rounded-t" style={{ height: `${(day.chats / 80) * 100}px`, minHeight: '4px' }} />
                                                <div className="flex-1 bg-blue-400/30 rounded-t" style={{ height: `${(day.tickets / 30) * 100}px`, minHeight: '4px' }} />
                                            </div>
                                            <span className="text-[9px] text-gray-600">{day.date.split(' ')[0]}</span>
                                        </div>
                                    ))}
                                </div>
                                <div className="flex items-center gap-4 mt-2 text-xs text-gray-500">
                                    <span className="flex items-center gap-1"><div className="w-2 h-2 bg-[#00ff41]/50 rounded" /> Чаты</span>
                                    <span className="flex items-center gap-1"><div className="w-2 h-2 bg-blue-400/50 rounded" /> Тикеты</span>
                                </div>
                            </div>

                            <div>
                                <h3 className="text-sm font-semibold mb-3 text-gray-300">Последние действия</h3>
                                <div className="space-y-2">
                                    {selectedCabinet.recentActions.map((action, i) => (
                                        <div key={i} className="flex items-center gap-3 p-3 rounded-lg bg-white/[0.02]">
                                            <div className={`w-2 h-2 rounded-full ${action.type === 'success' ? 'bg-[#00ff41]' : action.type === 'warning' ? 'bg-yellow-400' : 'bg-blue-400'}`} />
                                            <span className="text-sm text-gray-300 flex-1">{action.action}</span>
                                            <span className="text-xs text-gray-500">{action.time}</span>
                                        </div>
                                    ))}
                                </div>
                            </div>

                            <div className="flex gap-3 mt-6 pt-6 border-t border-white/[0.06]">
                                <button onClick={() => handleImpersonate(selectedCabinet)} className="flex items-center gap-2 px-5 py-2.5 bg-[#00ff41] hover:bg-[#00cc33] text-black font-medium rounded-lg transition-all hover:scale-[1.02]"><LogIn size={16} /> Войти в кабинет</button>
                                <button onClick={() => { handleToggleCabinetStatus(selectedCabinet.id); setShowCabinetDetailsModal(false); }} className="flex items-center gap-2 px-5 py-2.5 bg-yellow-500/10 hover:bg-yellow-500/20 text-yellow-400 rounded-lg transition-all border border-yellow-500/20">{selectedCabinet.status === 'active' ? <><PauseCircle size={16} /> Приостановить</> : <><PlayCircle size={16} /> Активировать</>}</button>
                                <button onClick={() => { handleDeleteCabinet(selectedCabinet.id); setShowCabinetDetailsModal(false); }} className="flex items-center gap-2 px-5 py-2.5 bg-red-500/10 hover:bg-red-500/20 text-red-400 rounded-lg transition-all border border-red-500/20 ml-auto"><Trash2 size={16} /> Удалить</button>
                            </div>
                        </div>
                    </div>
                </div>
            )}
        </div>
    )
}

export default OwnerDashboard