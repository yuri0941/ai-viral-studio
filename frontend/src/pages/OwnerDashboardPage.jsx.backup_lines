        const data = `AI Viral Studio LLC\nИНН: ${legalData.taxId}\nАдрес: ${legalData.address}\nР/с: ${legalData.account}\nБанк: ${legalData.bank}\nБИК: ${legalData.bik}\nSWIFT: ${legalData.swift}\nIBAN: ${legalData.iban}`.trim()
        const blob = new Blob([data], { type: 'text/plain' })
        const url = URL.createObjectURL(blob)
        const a = document.createElement('a')
        a.href = url; a.download = 'requisites_AI_Viral_Studio.txt'; a.click()
        URL.revokeObjectURL(url)
        showToast('Реквизиты скачаны')
    }

    const filteredCabinets = cabinets.filter(c => {
        if (cabinetFilter !== 'all' && c.status !== cabinetFilter) return false
        if (cabinetSearch && !c.name.toLowerCase().includes(cabinetSearch.toLowerCase()) && !c.email.toLowerCase().includes(cabinetSearch.toLowerCase())) return false
        return true
    })

    const getStatusColor = (status) => {
        switch (status) {
            case 'active': return 'bg-[#00ff41]/10 text-[#00ff41] border-[#00ff41]/20'
            case 'paused': return 'bg-yellow-500/10 text-yellow-400 border-yellow-500/20'
            case 'offline': return 'bg-gray-500/10 text-gray-400 border-gray-500/20'
            default: return 'bg-gray-500/10 text-gray-400'
        }
    }

    
    const getServerStatusColor = (status) => {
        switch (status) {
            case 'online': return 'bg-[#00ff41]/10 text-[#00ff41] border-[#00ff41]/20'
            case 'warning': return 'bg-yellow-500/10 text-yellow-400 border-yellow-500/20'
            case 'offline': return 'bg-red-500/10 text-red-400 border-red-500/20'
            default: return 'bg-gray-500/10 text-gray-400'
        }
    }

    const getLoadColor = (load) => {
        switch (load) {
            case 'low': return 'bg-[#00ff41]'
            case 'medium': return 'bg-yellow-400'
            case 'high': return 'bg-orange-400'
            case 'critical': return 'bg-red-400'
            default: return 'bg-gray-500'
        }
    }

    const getPromoStatusColor = (status) => {
        switch (status) {
            case 'active': return 'bg-[#00ff41]/10 text-[#00ff41] border-[#00ff41]/20'
            case 'scheduled': return 'bg-blue-500/10 text-blue-400 border-blue-500/20'
            case 'ended': return 'bg-gray-500/10 text-gray-400 border-gray-500/20'
            default: return 'bg-gray-500/10 text-gray-400'
        }
    }

    const getReferralStatusColor = (status) => {
        switch (status) {
            case 'active': return 'bg-[#00ff41]/10 text-[#00ff41] border-[#00ff41]/20'
            case 'paused': return 'bg-yellow-500/10 text-yellow-400 border-yellow-500/20'
            default: return 'bg-gray-500/10 text-gray-400'
        }
    }

    const getReferralStatusText = (status) => {
        switch (status) {
            case 'active': return 'Активен'
            case 'paused': return 'Приостановлен'
            default: return status
        }
    }

    const getStatusDot = (status) => {
        switch (status) {
            case 'active': return 'bg-[#00ff41]'
            case 'paused': return 'bg-yellow-400'
            case 'offline': return 'bg-gray-500'
            default: return 'bg-gray-500'
        }
    }

    return (
        <div className="min-h-screen bg-[#0a0a0f] text-white">
            {impersonatedCabinet && (
            <div className="fixed top-0 left-0 right-0 z-[60] bg-yellow-500 text-black px-4 py-2 flex items-center justify-between shadow-lg">
                <span className="font-medium flex items-center gap-2">
                    <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                    Вы вошли как: {impersonatedCabinet.name} ({impersonatedCabinet.role})
                </span>
                <button onClick={handleExitImpersonation} className="font-bold flex items-center gap-1 hover:bg-black/10 px-2 py-1 rounded transition-colors">
                    <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" /></svg>
                    Выйти из кабинета
                </button>
            </div>
        )}
        {toast && (
                <div className={`fixed top-4 right-4 z-50 px-4 py-3 rounded-xl flex items-center gap-2 shadow-lg transition-all ${toast.type === 'error' ? 'bg-red-500/90 text-white' : toast.type === 'warning' ? 'bg-yellow-500/90 text-black' : 'bg-emerald-500/90 text-black'}`}>
                    {toast.type === 'error' || toast.type === 'warning' ? <AlertCircle size={18} /> : <Check size={18} />}
                    <span className="font-medium">{toast.message}</span>
                </div>
            )}

            
            {/* SIDEBAR - Кабинеты сотрудников */}
            <aside className="fixed left-0 top-0 h-full w-64 bg-[#0f0f1a] border-r border-white/[0.06] z-40 hidden lg:flex flex-col">
                <div className="p-4 border-b border-white/[0.06]">
                    <div className="flex items-center gap-2 mb-1">
                        <div className="w-8 h-8 rounded-lg bg-gradient-to-br from-[#00ff41] to-[#2563eb] flex items-center justify-center">
                            <span className="text-black font-bold text-sm">AI</span>
                        </div>
                        <span className="font-bold text-white">Viral Studio</span>
                    </div>
                    <p className="text-xs text-gray-500">Панель владельца</p>
                </div>

                <div className="p-3">
                    <p className="text-xs text-gray-500 uppercase tracking-wider mb-3 px-2">Кабинеты сотрудников</p>
                    <div className="space-y-1">
                        {cabinets.map(cabinet => (
                            <button 
                                key={cabinet.id}
                                onClick={() => { setSelectedCabinet(cabinet); setShowCabinetDetailsModal(true); }}
                                className="w-full flex items-center gap-2 px-2 py-2 rounded-lg hover:bg-white/[0.04] transition-all group text-left"
                            >
                                <div className="relative">
                                    <div className="w-8 h-8 rounded-lg bg-gradient-to-br from-[#2563eb] to-[#7c3aed] flex items-center justify-center text-xs font-bold">
                                        {cabinet.avatar}
                                    </div>
                                    <div className={`absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 rounded-full border-2 border-[#0f0f1a] ${cabinet.stats.activeNow ? 'bg-[#00ff41]' : cabinet.status === 'paused' ? 'bg-yellow-400' : 'bg-gray-500'}`} />
                                </div>
                                <div className="flex-1 min-w-0">
                                    <p className="text-sm text-white truncate">{cabinet.name}</p>
                                    <p className="text-[10px] text-gray-500 truncate">{departments.find(d => d.id === cabinet.department)?.name || cabinet.department}</p>
                                </div>
                                <ChevronRight size={14} className="text-gray-600 opacity-0 group-hover:opacity-100 transition-opacity" />
                            </button>
                        ))}
                    </div>
                </div>

                <div className="mt-auto p-3 border-t border-white/[0.06]">
                    <div className="flex items-center gap-2 px-2 py-2 rounded-lg bg-white/[0.02]">
                        <div className="w-8 h-8 rounded-full bg-gradient-to-br from-[#00ff41] to-[#2563eb] flex items-center justify-center text-xs font-bold text-black">
                            {user?.name?.[0] || 'O'}
                        </div>
                        <div className="flex-1 min-w-0">
                            <p className="text-sm text-white truncate">{user?.name || 'Владелец'}</p>
                            <p className="text-[10px] text-[#00ff41]">Онлайн</p>
                        </div>
                    </div>
                </div>
            </aside>
<main className="lg:ml-64 min-h-screen">
                <div className="p-6 lg:p-8 max-w-7xl mx-auto">
                    <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
                        <div>
                            <div className="flex items-center gap-3 mb-2">
                                <span className="px-3 py-1 rounded-full bg-gradient-to-r from-[#00ff41] to-[#2563eb] text-black text-xs font-bold">OWNER</span>
                                <h1 className="text-3xl font-bold">Панель владельца</h1>
                            </div>
                            <p className="text-gray-400">Полный контроль над бизнесом и кабинетами сотрудников</p>
                        </div>
                        <button onClick={logout} className="flex items-center gap-2 px-4 py-2 bg-[#1a1a24] rounded-lg hover:bg-[#252530] transition-colors text-sm">
                            <ArrowUpRight size={16} /> Выйти
                        </button>
                    </div>

                    <div className="flex gap-2 mb-8 overflow-x-auto pb-2">
                        {tabs.map(tab => (
                            <button key={tab.id} onClick={() => setActiveTab(tab.id)}
                                className={`flex items-center gap-2 px-5 py-2.5 rounded-xl transition-all whitespace-nowrap ${activeTab === tab.id ? 'bg-[#00ff41]/10 text-[#00ff41] border border-[#00ff41]/20' : 'text-gray-400 hover:text-white hover:bg-white/5'}`}>
                                <span>{tab.icon}</span><span className="font-medium">{tab.label}</span>
                            </button>
                        ))}
                    </div>

                    {/* Overview Tab */}
                    {activeTab === 'overview' && (
                        <div className="space-y-8">
                            <div className="grid grid-cols-2 lg:grid-cols-3 gap-4">
                                {kpi.map((item, i) => (
                                    <div key={i} className="glass rounded-2xl p-5 border border-white/5">
                                        <p className="text-sm text-gray-400 mb-2">{item.label}</p>
                                        <div className="flex items-end gap-3">
                                            <span className="text-2xl font-black">{item.value}</span>
                                            <span className={`text-sm font-medium mb-1 ${item.positive ? 'text-[#00ff41]' : 'text-red-400'}`}>{item.change}</span>
                                        </div>
                                    </div>
                                ))}
                            </div>
                            <div className="grid lg:grid-cols-2 gap-6">
                                <div className="glass rounded-2xl p-6 border-white/5">
                                    <h3 className="font-bold mb-6">Финансы (P&L)</h3>
                                    <ResponsiveContainer width="100%" height={300}>
                                        <AreaChart data={revenueData}>
                                            <defs>
                                                <linearGradient id="revGrad" x1="0" y1="0" x2="0" y2="1"><stop offset="5%" stopColor="#00ff41" stopOpacity={0.3}/><stop offset="95%" stopColor="#00ff41" stopOpacity={0}/></linearGradient>
                                                <linearGradient id="profGrad" x1="0" y1="0" x2="0" y2="1"><stop offset="5%" stopColor="#2563eb" stopOpacity={0.3}/><stop offset="95%" stopColor="#2563eb" stopOpacity={0}/></linearGradient>
                                            </defs>
                                            <CartesianGrid strokeDasharray="3 3" stroke="rgba(255,255,255,0.05)" />
                                            <XAxis dataKey="month" stroke="rgba(255,255,255,0.3)" fontSize={12} />
                                            <YAxis stroke="rgba(255,255,255,0.3)" fontSize={12} />
                                            <Tooltip contentStyle={{ background: '#0f0f1a', border: '1px solid rgba(255,255,255,0.1)', borderRadius: '12px' }} />
                                            <Legend />
                                            <Area type="monotone" dataKey="revenue" stroke="#00ff41" fill="url(#revGrad)" name="Доход" />
                                            <Area type="monotone" dataKey="profit" stroke="#2563eb" fill="url(#profGrad)" name="Прибыль" />
                                        </AreaChart>
                                    </ResponsiveContainer>
                                </div>
                                <div className="glass rounded-2xl p-6 border-white/5">
                                    <h3 className="font-bold mb-6">Распределение по тарифам</h3>
                                    <ResponsiveContainer width="100%" height={300}>
                                        <PieChart>
                                            <Pie data={planData} cx="50%" cy="50%" innerRadius={60} outerRadius={100} paddingAngle={5} dataKey="users">
                                                {planData.map((entry, index) => (<Cell key={`cell-${index}`} fill={entry.color} />))}
                                            </Pie>
                                            <Tooltip contentStyle={{ background: '#0f0f1a', border: '1px solid rgba(255,255,255,0.1)', borderRadius: '12px' }} />
                                            <Legend />
                                        </PieChart>
                                    </ResponsiveContainer>
                                </div>
                            </div>
                        </div>
                    )}

                    {/* Team Tab */}
                    {activeTab === 'team' && (
                        <div className="glass rounded-2xl p-6 border-white/5">
                            <div className="flex items-center justify-between mb-6">
                                <h3 className="font-bold text-lg">Команда</h3>
                                <button onClick={() => setShowAddStaffModal(true)} className="flex items-center gap-2 px-4 py-2 bg-emerald-500 hover:bg-emerald-600 text-black font-medium rounded-lg transition-all hover:scale-105 text-sm">
                                    <UserPlus size={16} /> Добавить сотрудника
                                </button>
                            </div>
                            <div className="overflow-x-auto">
                                <table className="w-full">
                                    <thead><tr className="border-b border-white/5">
                                        <th className="text-left py-3 px-4 text-sm font-medium text-gray-400">Сотрудник</th>
                                        <th className="text-left py-3 px-4 text-sm font-medium text-gray-400">Роль</th>
                                        <th className="text-left py-3 px-4 text-sm font-medium text-gray-400">Статус</th>
                                        <th className="text-left py-3 px-4 text-sm font-medium text-gray-400">Активность</th>
                                        <th className="text-right py-3 px-4 text-sm font-medium text-gray-400">Задачи</th>
                                        <th className="text-right py-3 px-4 text-sm font-medium text-gray-400">Действия</th>
                                    </tr></thead>
                                    <tbody>
                                        {staff.map(member => (
                                            <tr key={member.id} className="border-b border-white/5 hover:bg-white/[0.02]">
                                                <td className="py-4 px-4">
                                                    <div className="flex items-center gap-3">
                                                        <div className="w-10 h-10 rounded-xl bg-gradient-to-br from-[#2563eb] to-[#7c3aed] flex items-center justify-center font-bold">{member.name[0]}</div>
                                                        <div><p className="font-medium">{member.name}</p><p className="text-xs text-gray-500">{member.email}</p></div>
                                                    </div>
                                                </td>
                                                <td className="py-4 px-4"><span className={`text-xs px-2.5 py-1 rounded-full ${member.role === 'admin' ? 'bg-red-500/10 text-red-400' : member.role === 'owner' ? 'bg-[#00ff41]/10 text-[#00ff41]' : 'bg-blue-500/10 text-blue-400'}`}>{member.role}</span></td>
                                                <td className="py-4 px-4"><span className={`flex items-center gap-1.5 text-sm ${member.status === 'active' ? 'text-[#00ff41]' : 'text-gray-500'}`}><span className={`w-2 h-2 rounded-full ${member.status === 'active' ? 'bg-[#00ff41]' : 'bg-gray-500'}`} />{member.status === 'active' ? 'Онлайн' : 'Оффлайн'}</span></td>
                                                <td className="py-4 px-4 text-sm text-gray-400">{member.lastActive}</td>
                                                <td className="py-4 px-4 text-right font-medium">{member.tasks}</td>
                                                <td className="py-4 px-4 text-right">
                                                    <button onClick={() => { setSelectedStaff(member); setShowResetPasswordModal(true) }} className="text-sm text-emerald-400 hover:underline mr-3 inline-flex items-center gap-1"><KeyRound size={14} /> Сбросить</button>
                                                    <button onClick={() => handleDeleteStaff(member.id)} className="text-sm text-red-400 hover:underline inline-flex items-center gap-1"><Trash2 size={14} /> Удалить</button>
                                                </td>
                                            </tr>
                                        ))}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    )}

                    {/* CABINETS TAB */}
                    {activeTab === 'cabinets' && (
                        <div className="space-y-6">
                            <div className="grid grid-cols-2 lg:grid-cols-4 gap-4">
                                <div className="glass rounded-2xl p-5 border border-white/5"><p className="text-sm text-gray-400 mb-1">Всего кабинетов</p><p className="text-2xl font-black text-white">{cabinets.length}</p></div>
                                <div className="glass rounded-2xl p-5 border border-white/5"><p className="text-sm text-gray-400 mb-1">Активных</p><p className="text-2xl font-black text-[#00ff41]">{cabinets.filter(c => c.status === 'active').length}</p></div>
                                <div className="glass rounded-2xl p-5 border border-white/5"><p className="text-sm text-gray-400 mb-1">Приостановленных</p><p className="text-2xl font-black text-yellow-400">{cabinets.filter(c => c.status === 'paused').length}</p></div>
                                <div className="glass rounded-2xl p-5 border border-white/5"><p className="text-sm text-gray-400 mb-1">Онлайн сейчас</p><p className="text-2xl font-black text-blue-400">{cabinets.filter(c => c.stats.activeNow).length}</p></div>
                            </div>

                            <div className="flex flex-wrap items-center justify-between gap-4">
                                <div className="flex items-center gap-3 flex-wrap">
                                    <div className="relative">
                                        <Search className="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-500" />
                                        <input type="text" value={cabinetSearch} onChange={e => setCabinetSearch(e.target.value)} placeholder="Поиск..." className="pl-10 pr-4 py-2 bg-[#1a1a24] rounded-xl border border-white/10 text-sm text-white placeholder-gray-500 outline-none focus:border-[#00ff41]/30 w-64" />
                                    </div>
                                    <select value={cabinetFilter} onChange={e => setCabinetFilter(e.target.value)} className="px-4 py-2 bg-[#1a1a24] rounded-xl border border-white/10 text-sm text-white outline-none focus:border-[#00ff41]/30">
                                        <option value="all">Все статусы</option><option value="active">Активные</option><option value="paused">Приостановленные</option>
                                    </select>
                                </div>
                                <button onClick={() => setShowCabinetModal(true)} className="flex items-center gap-2 px-5 py-2.5 bg-[#00ff41] hover:bg-[#00cc33] text-black font-semibold rounded-xl transition-all hover:scale-[1.02] text-sm">
                                    <Plus size={16} /> Создать кабинет
                                </button>
                            </div>

                            <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
                                {filteredCabinets.map(cabinet => (
                                    <div key={cabinet.id} className="glass rounded-2xl p-5 border border-white/5 hover:border-white/[0.1] transition-all group">
                                        <div className="flex items-start justify-between mb-4">
                                            <div className="flex items-center gap-3">
                                                <div className="w-12 h-12 rounded-xl bg-gradient-to-br from-[#2563eb] to-[#7c3aed] flex items-center justify-center text-lg font-bold">{cabinet.avatar}</div>
                                                <div>
                                                    <div className="flex items-center gap-2">
                                                        <h3 className="font-semibold text-white">{cabinet.name}</h3>
                                                        <span className={`text-[10px] px-2 py-0.5 rounded-full border ${getStatusColor(cabinet.status)}`}>{cabinet.status === 'active' ? 'Активен' : 'Приостановлен'}</span>
                                                    </div>
                                                    <p className="text-xs text-gray-500">{cabinet.email}</p>
                                                    <div className="flex items-center gap-3 mt-1">
                                                        <span className="text-[10px] text-gray-500 flex items-center gap-1"><Briefcase className="w-3 h-3" /> {departments.find(d => d.id === cabinet.department)?.name || cabinet.department}</span>
                                                        <span className="text-[10px] text-gray-500 flex items-center gap-1"><Clock className="w-3 h-3" /> {cabinet.workHours}</span>
                                                    </div>
                                                </div>
                                            </div>
                                            <div className="flex items-center gap-1">
                                                <button onClick={() => { setSelectedCabinet(cabinet); setShowCabinetDetailsModal(true) }} className="p-2 rounded-lg hover:bg-white/5 transition-colors text-gray-400 hover:text-white" title="Подробности"><Eye size={16} /></button>
                                                <button onClick={() => handleImpersonate(cabinet)} className="p-2 rounded-lg hover:bg-white/5 transition-colors text-gray-400 hover:text-[#00ff41]" title="Войти в кабинет"><LogIn size={16} /></button>
                                                <button onClick={() => handleToggleCabinetStatus(cabinet.id)} className="p-2 rounded-lg hover:bg-white/5 transition-colors text-gray-400 hover:text-yellow-400" title={cabinet.status === 'active' ? 'Приостановить' : 'Активировать'}>{cabinet.status === 'active' ? <PauseCircle size={16} /> : <PlayCircle size={16} />}</button>
                                                <button onClick={() => handleDeleteCabinet(cabinet.id)} className="p-2 rounded-lg hover:bg-white/5 transition-colors text-gray-400 hover:text-red-400" title="Удалить"><Trash2 size={16} /></button>
                                            </div>
                                        </div>

                                        <div className="grid grid-cols-4 gap-2 mb-4">
                                            <div className="p-2 rounded-lg bg-white/[0.02] text-center"><p className="text-lg font-bold text-white">{cabinet.stats.totalChats}</p><p className="text-[10px] text-gray-500">Чатов</p></div>
                                            <div className="p-2 rounded-lg bg-white/[0.02] text-center"><p className="text-lg font-bold text-[#00ff41]">{cabinet.stats.resolvedTickets}</p><p className="text-[10px] text-gray-500">Тикетов</p></div>
                                            <div className="p-2 rounded-lg bg-white/[0.02] text-center"><p className="text-lg font-bold text-blue-400">{cabinet.stats.avgResponseTime}</p><p className="text-[10px] text-gray-500">Ответ</p></div>
                                            <div className="p-2 rounded-lg bg-white/[0.02] text-center"><p className="text-lg font-bold text-purple-400">{cabinet.stats.satisfactionRate}%</p><p className="text-[10px] text-gray-500">CSAT</p></div>
                                        </div>

                                        <div className="flex flex-wrap gap-1.5 mb-3">
                                            {cabinet.permissions.map(perm => {
                                                const permInfo = allPermissions.find(p => p.id === perm)
                                                return <span key={perm} className="text-[10px] px-2 py-0.5 rounded-full bg-white/5 text-gray-400 border border-white/[0.06]">{permInfo?.name || perm}</span>
                                            })}
                                        </div>

                                        <div className="space-y-1.5">
                                            {cabinet.recentActions.slice(0, 2).map((action, i) => (
                                                <div key={i} className="flex items-center gap-2 text-xs">
                                                    <div className={`w-1.5 h-1.5 rounded-full ${action.type === 'success' ? 'bg-[#00ff41]' : action.type === 'warning' ? 'bg-yellow-400' : 'bg-blue-400'}`} />
                                                    <span className="text-gray-400 flex-1 truncate">{action.action}</span>
                                                    <span className="text-gray-600">{action.time}</span>
                                                </div>
                                            ))}
                                        </div>

                                        <div className="mt-4 pt-4 border-t border-white/[0.04]">
                                            <p className="text-[10px] text-gray-500 mb-2">Активность за 7 дней</p>
                                            <div className="flex items-end gap-1 h-12">
                                                {cabinet.activity.map((day, i) => (
                                                    <div key={i} className="flex-1 flex flex-col items-center gap-1 group">
                                                        <div className="w-full bg-[#00ff41]/20 rounded-t hover:bg-[#00ff41]/40 transition-all relative" style={{ height: `${(day.chats / 80) * 100}%`, minHeight: '4px' }}>
                                                            <div className="absolute -top-6 left-1/2 -translate-x-1/2 bg-[#1a1a24] px-2 py-0.5 rounded text-[10px] text-white opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap border border-white/10">{day.chats} чатов</div>
                                                        </div>
                                                        <span className="text-[9px] text-gray-600">{day.date.split(' ')[0]}</span>
                                                    </div>
                                                ))}
