    const togglePermission = (permId) => {
        setNewCabinetForm(prev => {
            const perms = prev.permissions.includes(permId) ? prev.permissions.filter(p => p !== permId) : [...prev.permissions, permId]
            return { ...prev, permissions: perms }
        })
