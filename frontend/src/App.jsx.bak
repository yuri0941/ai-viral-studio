            { path: '/staff', label: 'Staff Panel', icon: Briefcase },
            { path: '/ai-chat', label: 'AI Chat', icon: MessageSquare },
            { path: '/analyzer', label: 'Анализ контента', icon: Link2 },
            { path: '/scheduler', label: 'Планировщик', icon: Calendar },
