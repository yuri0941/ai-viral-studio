{
  "appId": "com.ai.viral.studio",
  "appName": "AI Viral Studio",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "url": "https://ai-viral-studio.pages.dev",
    "allowNavigation": [
      "*.pages.dev",
      "*.ai-viral-studio.ru",
      "*.aiviral-studio.ru",
      "*.onrender.com"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#0a0a0f",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP"
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "CapacitorUpdater": {
      "autoUpdate": true,
      "channel": "production"
    }
  },
  "ios": {
    "contentInset": "always"
  },
  "android": {
    "buildOptions": {
      "keystorePath": null,
      "keystoreAlias": null
    }
  }
}
