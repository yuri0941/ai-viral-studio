# ============================================================
# AI VIRAL STUDIO — ПРИМЕР .env (скопируй в .env и заполни СВОИМИ значениями)
# [security-hardening Б5-З4] реальные ключи удалены 2026-08-28 — старые значения считаются скомпрометированными
# ============================================================

# 1. СЕРВЕР
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:5000
HOST=0.0.0.0

# 2. БАЗА ДАННЫХ (локальная MongoDB)
MONGO_URI=mongodb://localhost:27017/ai_viral_studio
MONGODB_URI=mongodb://localhost:27017/ai_viral_studio

# 3. JWT (сгенерируй: openssl rand -hex 48)
JWT_SECRET=change_me_long_random_string
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
JWT_ALGORITHM=HS256

# 4. AI-ПРОВАЙДЕРЫ (Groq — основной)
GROQ_ENABLED=true
GROQ_API_KEY=gsk_your_groq_key_here
GROQ_API_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-70b-versatile
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=4096
GROQ_TIMEOUT=30000

# Резервные AI
OPENROUTER_ENABLED=true
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here
OPENROUTER_API_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.1-70b-instruct:free

DEEPSEEK_ENABLED=true
DEEPSEEK_API_KEY=sk-your_deepseek_key_here
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 5. YOUTUBE
YOUTUBE_ENABLED=true
YOUTUBE_API_KEY=AIza_your_youtube_key_here
YOUTUBE_QUOTA_DAY=10000

# 6. BUFFER
BUFFER_ENABLED=true
BUFFER_ACCESS_TOKEN=your_buffer_token_here
BUFFER_API_URL=https://api.buffer.com/v1

# 7. TELEGRAM
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=123456:your_bot_token_here
# [security-hardening Б5-З2.1] секрет для верификации webhook (X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CHAT_ID=

# 8. REDIS (отключён для локальной разработки)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379

# 9. EMAIL (отключён для локальной разработки)
EMAIL_ENABLED=false

# 10. CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# 11. RATE LIMITING
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=15

# 12. ЛОГИРОВАНИЕ
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true

# 13. ФРОНТЕНД
VITE_API_URL=http://localhost:5000/api/v1
VITE_APP_VERSION=0.1.0
VITE_ENVIRONMENT=development
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here

# 14. БЕЗОПАСНОСТЬ
PASSWORD_MIN_LENGTH=8
BRUTE_FORCE_MAX_ATTEMPTS=5
BRUTE_FORCE_LOCKOUT_TIME=900000

# 15. ПЛАНИРОВЩИК
SCHEDULER_ENABLED=true
CRON_ENABLED=true

# 16. WEBSOCKET
WEBSOCKET_ENABLED=true

# 17. PWA
PWA_ENABLED=true

# 18. SEO
SEO_ENABLED=true

# 19. SWAGGER
SWAGGER_ENABLED=true

# 20. SENTRY (без DSN — молча выключен)
SENTRY_ENABLED=false
SENTRY_DSN=
VITE_SENTRY_DSN=

# [BOT-ROUTING-FIX] Telegram usernames (without @) — single source of truth for UI links
# [LANDING-RESTORE] ОБЯЗАТЕЛЬНО задать в Cloudflare Pages (Settings → Environment variables) для production-билда.
# Если переменная не задана/пустая — сработает жёсткий фолбэк на значения ниже (см. src/config/bots.js),
# но явное задание переменных — источник истины при смене username.
VITE_CLIENT_BOT_USERNAME=aiviral_alerts_bot
VITE_OWNER_BOT_USERNAME=omega_aiviral_bot
VITE_TELEGRAM_CHANNEL_USERNAME=aiviralstudio

# ⚠️ .env НЕ коммитить! В git ходит только этот пример с плейсхолдерами.
